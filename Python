def admin_required(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        if not current_user.is_authenticated:
            return login_manager.unauthorized()
        if not current_user.is_admin():
            abort(403)
        return f(*args, **kwargs)
    return wrapper


class LoginThrottle:
    """
    In-memory failure counter (per process). Good enough for a single worker;
    with several workers use Flask-Limiter with a shared store instead.
    """

    def __init__(self, window: int = 900):
        self.window = window
        self._fails: Dict[str, Deque[float]] = defaultdict(deque)
        self._lock = threading.Lock()

    def wait_seconds(self, key: str, limit: int) -> int:
        now = time.time()
        with self._lock:
            q = self._fails.get(key)
            if not q:
                return 0
            while q and now - q[0] > self.window:
                q.popleft()
            if not q:
                del self._fails[key]
                return 0
            if len(q) >= limit:
                return max(1, int(self.window - (now - q[0])))
            return 0

    def fail(self, key: str) -> None:
        with self._lock:
            self._fails[key].append(time.time())

    def clear(self, key: str) -> None:
        with self._lock:
            self._fails.pop(key, None)


