# HELPERS
# =============================================================================

def _table_exists(conn: sqlite3.Connection, name: str) -> bool:
    row = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
        (name,)).fetchone()
    return row is not None


def _discard(path: Optional[Path]) -> None:
    if path is not None:
        try:
            path.unlink(missing_ok=True)
        except OSError:
            LOG.warning("Could not remove orphaned upload %s", path)


# =============================================================================
# CLI
# =============================================================================

def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="sicca_app.py")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("run", help="start the web server (default)")
    cu = sub.add_parser("create-user", help="add a user")
    cu.add_argument("username")
    cu.add_argument("--role", choices=["analyst", "admin"], default="analyst")
    tr = sub.add_parser("train", help="train the ML model from a CSV")
    tr.add_argument("csv")
    sub.add_parser("check-templates",
                   help="show where templates are found")
    tr2 = sub.add_parser("trace",
                         help="print the Bayesian arithmetic for one case")
    tr2.add_argument("case_id")
    args = parser.parse_args(argv)
    cmd = args.cmd or "run"

    if cmd == "check-templates":
        _, index = build_template_loader()
        for name in REQUIRED_TEMPLATES:
            print(f"{name:30s} -> "
                  f"{index.get(name, 'MISSING (built-in fallback)')}")
        extra = sorted(set(index) - set(REQUIRED_TEMPLATES))
        if extra:
            print("\nOther templates found:")
            for name in extra:
                print(f"  {name:28s} {index[name]}")
        return 0

    init_db()
    load_strength_factors()

    if cmd == "create-user":
        pw = getpass.getpass("Password: ")
        if pw != getpass.getpass("Repeat password: "):
            print("Passwords do not match.", file=sys.stderr)
            return 1
        try:
            create_user(args.username, pw, args.role)
        except (ValueError, sqlite3.IntegrityError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Created {args.role} '{args.username}'.")
        return 0

    if cmd == "train":
        model = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH,
                        key=load_or_create_secret_key().encode("utf-8"))
        try:
            m = model.train(pd.read_csv(args.csv))
        except (ValueError, OSError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Trained v{m['model_version']}: AUC={m['roc_auc']} "
              f"accuracy={m['accuracy']:.3f} "
              f"(train {m['training_samples']}, test {m['test_samples']})")
        return 0

    if cmd == "trace":
        if calib is None:
            print(f"Calibration module unavailable: {_CALIB_IMPORT_ERROR}",
                  file=sys.stderr)
            return 1
        with db() as conn:
            row = conn.execute(
                "SELECT * FROM cases WHERE case_id = ?", (args.case_id,)
            ).fetchone()
        if row is None:
            print(f"No such case: {args.case_id}", file=sys.stderr)
            return 1
        trace = build_trace(dict(row))
        print(calib.trace_summary(trace))
        print()
        print(_pretty(trace))
        return 0

    if Config.DEBUG and Config.HOST not in LOOPBACK_HOSTS:
        print("Refusing to run with SICCA_DEBUG=1 on a non-loopback host: "
              "the Werkzeug debugger allows remote code execution.",
              file=sys.stderr)
        return 1
    # The built-in dev server on loopback is plain http, so only there (and
    # only if SICCA_COOKIE_SECURE is unset) the session cookie is not Secure.
    dev_http = (os.environ.get("SICCA_COOKIE_SECURE") is None
                and Config.HOST in LOOPBACK_HOSTS)
    if dev_http:
        LOG.info("Development server on loopback: session cookie is not "
                 "marked Secure.")
    create_app(dev_insecure_cookies=dev_http).run(
        host=Config.HOST, port=Config.PORT, debug=Config.DEBUG)
    return 0


if __name__ == "__main__":
    sys.exit(main())
