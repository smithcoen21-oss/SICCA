# =============================================================================
# SICCA CALIBRATION MODULE
# -----------------------------------------------------------------------------
# Pure functions that expose the arithmetic of the Bayesian layer.
#
# Nothing in this module touches Flask, the database, or the filesystem.
# Everything is passed in as an argument, so the module can be unit-tested
# in isolation and cannot read data it was not given.
# =============================================================================

from __future__ import annotations

from math import exp, isfinite, log1p
from typing import Any, Dict, Iterable, List, Mapping, Sequence


def odds(p: float) -> float:
    p = min(max(float(p), 1e-6), 1 - 1e-6)
    return p / (1 - p)


def prob(o: float) -> float:
    return float(o) / (1.0 + float(o))


def safe_float(value: Any, default: float) -> float:
    try:
        x = float(value)
    except (TypeError, ValueError):
        return default
    return x if isfinite(x) else default


def trace_case(
    case: Mapping[str, Any],
    *,
    base_prior: float,
    type_lr_map: Mapping[str, float],
    status_lr_map: Mapping[str, float],
    priority_lr_map: Mapping[str, float],
    age_decay_lambda: float,
    min_feature_lr: float,
    max_feature_lr: float,
    high_threshold: float,
    medium_threshold: float,
    current_year: int,
) -> Dict[str, Any]:
    ctype = str(case.get("type", "unknown")).lower()
    type_lr = float(type_lr_map.get(ctype, 1.0))

    ev_count = int(safe_float(case.get("evidence_count", 0), 0))
    su_count = int(safe_float(case.get("suspects_count", 0), 0))
    status = str(case.get("status", "unknown")).lower()
    priority = str(case.get("priority", "medium")).lower()

    ev_component = 1.0 + 0.35 * log1p(max(0, ev_count))
    su_component = 1.0 + 0.10 * max(0, su_count - 1)
    st_component = float(status_lr_map.get(status, 1.0))
    pr_component = float(priority_lr_map.get(priority, 1.0))
    ev_lr_raw = ev_component * su_component * st_component * pr_component
    ev_lr = max(min_feature_lr, min(max_feature_lr, ev_lr_raw))

    prior_odds = odds(base_prior)
    posterior_odds = prior_odds * type_lr * ev_lr
    posterior = prob(posterior_odds)

    year = int(safe_float(case.get("year", current_year), current_year))
    age = max(0, current_year - year)
    base_conf = safe_float(case.get("confidence", 0.5), 0.5)
    base_conf = max(0.0, min(1.0, base_conf))
    decay_factor = exp(-age_decay_lambda * age)
    decayed_conf = max(0.0, min(1.0, base_conf * decay_factor))
    multiplier = 0.5 + 0.5 * decayed_conf
    adjusted = posterior * multiplier

    band = (
        "high" if adjusted > high_threshold
        else "medium" if adjusted > medium_threshold
        else "low"
    )

    return {
        "input": {
            "type": ctype,
            "evidence_count": ev_count,
            "suspects_count": su_count,
            "status": status,
            "priority": priority,
            "year": year,
            "confidence": base_conf,
        },
        "configuration": {
            "base_prior": float(base_prior),
            "age_decay_lambda": float(age_decay_lambda),
            "min_feature_lr": float(min_feature_lr),
            "max_feature_lr": float(max_feature_lr),
            "high_threshold": float(high_threshold),
            "medium_threshold": float(medium_threshold),
        },
        "step_type_lr": {
            "type_lr": type_lr,
            "note": "likelihood ratio for the crime type",
        },
        "step_evidence_lr": {
            "evidence_component": round(ev_component, 6),
            "suspects_component": round(su_component, 6),
            "status_component": round(st_component, 6),
            "priority_component": round(pr_component, 6),
            "raw_product": round(ev_lr_raw, 6),
            "clamped": round(ev_lr, 6),
            "clamped_hit": "none"
                if abs(ev_lr_raw - ev_lr) < 1e-9
                else ("min" if ev_lr_raw < ev_lr else "max"),
        },
        "step_bayes": {
            "prior_probability": round(float(base_prior), 6),
            "prior_odds": round(prior_odds, 6),
            "posterior_odds": round(posterior_odds, 6),
            "posterior_probability": round(posterior, 6),
        },
        "step_decay": {
            "case_age_years": age,
            "base_confidence": round(base_conf, 6),
            "decay_factor": round(decay_factor, 6),
            "decayed_confidence": round(decayed_conf, 6),
            "multiplier": round(multiplier, 6),
        },
        "result": {
            "posterior": round(posterior, 6),
            "adjusted_posterior": round(adjusted, 6),
            "band": band,
        },
    }


def decay_curve(
    *,
    posterior: float,
    confidence: float,
    ages: Sequence[int],
    age_decay_lambda: float,
) -> List[Dict[str, float]]:
    out: List[Dict[str, float]] = []
    for age in ages:
        age = int(age)
        decayed = max(0.0, min(1.0, float(confidence)
                                * exp(-age_decay_lambda * age)))
        adjusted = float(posterior) * (0.5 + 0.5 * decayed)
        out.append({
            "age": float(age),
            "decayed_confidence": round(decayed, 6),
            "adjusted": round(adjusted, 6),
        })
    return out


def decay_curve_png(
    *,
    curves: Mapping[str, Mapping[str, Any]],
    high_threshold: float,
    medium_threshold: float,
    title: str,
    path: str,
    max_age: int = 60,
) -> str:
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except Exception as exc:
        raise RuntimeError(f"matplotlib unavailable: {exc}") from exc

    ages = list(range(0, max_age + 1))
    fig, ax = plt.subplots(figsize=(9, 5.5))
    for label, cfg in curves.items():
        points = decay_curve(
            posterior=float(cfg["posterior"]),
            confidence=float(cfg["confidence"]),
            ages=ages,
            age_decay_lambda=float(cfg.get("age_decay_lambda", 0.05)),
        )
        ax.plot([p["age"] for p in points],
                [p["adjusted"] for p in points],
                linewidth=2, label=label)

    ax.axhline(high_threshold, color="#ef4444", linestyle="--",
               linewidth=1.2, label=f"high threshold ({high_threshold})")
    ax.axhline(medium_threshold, color="#f59e0b", linestyle="--",
               linewidth=1.2, label=f"medium threshold ({medium_threshold})")

    ax.set_xlabel("Case age (years)")
    ax.set_ylabel("Adjusted posterior")
    ax.set_title(title)
    ax.set_ylim(0, 1)
    ax.grid(alpha=0.25)
    ax.legend(loc="upper right", fontsize=9)

    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)
    return path


def band_for(score: float, high: float, medium: float) -> str:
    return "high" if score > high else "medium" if score > medium else "low"


def sensitivity_grid(
    cases: Iterable[Mapping[str, Any]],
    *,
    priors: Sequence[float],
    type_lrs: Sequence[float],
    target_type: str,
    status_lr_map: Mapping[str, float],
    priority_lr_map: Mapping[str, float],
    age_decay_lambda: float,
    min_feature_lr: float,
    max_feature_lr: float,
    high_threshold: float,
    medium_threshold: float,
    current_year: int,
    cap: int = 200,
) -> Dict[str, Any]:
    cases = list(cases)[:cap]
    target_type = target_type.lower()

    out_cases = []
    for case in cases:
        ctype = str(case.get("type", "unknown")).lower()
        if ctype != target_type:
            continue
        trace = trace_case(
            case,
            base_prior=0.5,
            type_lr_map={target_type: 1.0},
            status_lr_map=status_lr_map,
            priority_lr_map=priority_lr_map,
            age_decay_lambda=age_decay_lambda,
            min_feature_lr=min_feature_lr,
            max_feature_lr=max_feature_lr,
            high_threshold=high_threshold,
            medium_threshold=medium_threshold,
            current_year=current_year,
        )
        out_cases.append({
            "case_id": case.get("case_id"),
            "case_name": case.get("case_name"),
            "year": case.get("year"),
            "evidence_lr": trace["step_evidence_lr"]["clamped"],
            "decay_multiplier": trace["step_decay"]["multiplier"],
        })

    grid = []
    for prior in priors:
        for tl in type_lrs:
            bands: Dict[str, str] = {}
            scores: Dict[str, float] = {}
            for c in out_cases:
                posterior = prob(odds(prior) * tl * c["evidence_lr"])
                adjusted = posterior * c["decay_multiplier"]
                scores[c["case_id"]] = round(adjusted, 6)
                bands[c["case_id"]] = band_for(adjusted,
                                               high_threshold, medium_threshold)
            grid.append({
                "prior": float(prior),
                "type_lr": float(tl),
                "scores": scores,
                "bands": bands,
            })

    return {
        "target_type": target_type,
        "current_year": int(current_year),
        "cases": out_cases,
        "priors": [float(p) for p in priors],
        "type_lrs": [float(t) for t in type_lrs],
        "grid": grid,
        "cap": cap,
        "cases_seen": len(out_cases),
        "high_threshold": float(high_threshold),
        "medium_threshold": float(medium_threshold),
    }


def trace_summary(trace: Mapping[str, Any]) -> str:
    r = trace["result"]
    b = trace["step_bayes"]
    d = trace["step_decay"]
    return (
        f"prior={b['prior_probability']:.2f} "
        f"-> odds={b['prior_odds']:.3f} "
        f"-> posterior={r['posterior']:.3f} "
        f"-> decay(x{d['multiplier']:.2f}) "
        f"-> adjusted={r['adjusted_posterior']:.3f} "
        f"[{r['band']}]"
    )
''')
