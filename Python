class SeverityHeuristics:
    CATEGORY_RISK = {"violent_crime": 0.8, "financial_crime": 0.4, "property_crime": 0.3}
    DEFAULT_RISK = 0.5
    CRIME_CATEGORY = {
        "homicide": "violent_crime", "assault": "violent_crime",
        "robbery": "violent_crime", "fraud": "financial_crime",
        "theft": "property_crime", "burglary": "property_crime",
        "arson": "property_crime", "vandalism": "property_crime",
    }

    @staticmethod
    def risk(case: Mapping[str, Any]) -> Dict[str, Any]:
        category = SeverityHeuristics.CRIME_CATEGORY.get(str(case.get("type", "")).lower(), "other_crime")
        crime_risk = SeverityHeuristics.CATEGORY_RISK.get(category, SeverityHeuristics.DEFAULT_RISK)
        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        score = (0.6 * crime_risk + 0.2 * min(1.0, ev / 10.0) + 0.2 * min(1.0, su / 5.0))
        return {
            "risk_score": round(score, 3),
            "risk_level": risk_level(score),
            "crime_category": category,
            "method": "transparent_heuristic",
        }


CrossBorderHeuristics = SeverityHeuristics


class HybridEngine:
    W_BAYES = 0.6
    W_ML = 0.4

    def __init__(self, ml: MLModel, condition_fn=None):
        self.ml = ml
        self._condition_fn = condition_fn

    @staticmethod
    def _ml_certainty(p: float) -> str:
        d = abs(p - 0.5) * 2
        return "high" if d > 0.6 else "medium" if d > 0.3 else "low"

    def analyze(self, case: Mapping[str, Any]) -> Dict[str, Any]:
        t0 = time.perf_counter()
        bayes = bayesian_score(case, datetime.now().year)
        ml_prob, ml_err = self.ml.predict_one(case)
        version = self.ml.meta.get("version", Config.MODEL_VERSION)

        if self._condition_fn is not None and conditions is not None:
            try:
                condition_profile = self._condition_fn(dict(case))
            except Exception:
                condition_profile = {"combined_lr": 1.0, "summary": "failed"}
        else:
            condition_profile = {"combined_lr": 1.0, "summary": "unavailable"}

        condition_lr = float(condition_profile.get("combined_lr", 1.0))
        evidence_only = float(bayes["adjusted_posterior"])
        adjusted = _prob(_odds(evidence_only) * condition_lr)

        if ml_prob is None:
            final = adjusted
            weights = {"bayesian": 1.0, "ml": 0.0}
            ml_block = {"probability": None, "confidence": "unavailable", "model_available": False, "error": ml_err}
        else:
            weights = {"bayesian": self.W_BAYES, "ml": self.W_ML}
            final = (weights["bayesian"] * adjusted + weights["ml"] * ml_prob)
            ml_block = {"probability": ml_prob, "confidence": self._ml_certainty(ml_prob), "model_available": True, "error": ""}

        agreement = (ml_prob is not None and abs(adjusted - ml_prob) <= 0.2)
        b = bayes["confidence"]
        overall = "high" if (b > 0.7 and ml_block.get("confidence") == "high" and agreement) else ("medium" if b > 0.5 else "low")

        hybrid = {
            "final_risk_score": float(final),
            "risk_level": risk_level(final),
            "weight_bayesian": weights["bayesian"],
            "weight_ml": weights["ml"],
            "agreement": agreement,
            "confidence": overall,
            "calculation": f"{weights['bayesian']:.0%} Bayesian + {weights['ml']:.0%} ML",
            "evidence_only_score": round(evidence_only, 6),
            "condition_factor": round(condition_lr, 4),
        }
        return {
            "bayesian": bayes,
            "conditions": condition_profile,
            "machine_learning": ml_block,
            "hybrid_analysis": hybrid,
            "cross_border": SeverityHeuristics.risk(case),
            "insights": ["Scores are decision support; human review required."],
            "metadata": {"timestamp": now_iso(), "analysis_time": round(time.perf_counter() - t0, 4)},
        }


