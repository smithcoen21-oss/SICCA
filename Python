CASE_ID_RE = re.compile(r"^[A-Za-z0-9_\-]{1,50}$")


def validate_case_id(case_id: str) -> Tuple[bool, str]:
    if not case_id or not CASE_ID_RE.match(case_id):
        return False, "Case ID must be 1-50 characters: letters, digits, - or _"
    return True, ""


def coerce_int(value: Any, default: int, lo: int, hi: int) -> int:
    # FIX #16: range validation for every numeric field.
    try:
        n = int(float(value))
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


def coerce_float(value: Any, default: float, lo: float, hi: float) -> float:
    try:
        x = float(value)
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, x))


def clean_text(value: Any, max_len: int = 1000) -> str:
    """Store raw text. Jinja escapes on render; no double-escaping."""
    if value is None:
        return ""
    return str(value).strip()[:max_len]


def safe_upload_name(case_id: str, filename: str) -> str:
    # FIX #5: secure_filename on both parts; UUID to avoid collisions.
    base = secure_filename(filename) or "upload"
    return f"{secure_filename(case_id)}__{uuid.uuid4().hex[:8]}__{base}"


# =============================================================================
# BAYESIAN MODEL  (FIX #7 + #8: evidence updates the posterior; decay matters.)
# =============================================================================

class BayesianConfig:
    """
    Priors are per-crime base odds (independent, NOT normalised to 1).
    Likelihood ratio = BASE_LR[type] * f(evidence, suspects, status, priority).
    """

    PRIORS = {
        "fraud": 0.12, "homicide": 0.35, "robbery": 0.20, "arson": 0.25,
        "burglary": 0.18, "assault": 0.22, "theft": 0.15,
        "vandalism": 0.10, "unknown": 0.10,
    }
    BASE_LR = {
        "fraud": 1.2, "homicide": 2.0, "robbery": 1.6, "arson": 1.8,
        "burglary": 1.4, "assault": 1.7, "theft": 1.3,
        "vandalism": 1.1, "unknown": 1.0,
    }
    AGE_DECAY_LAMBDA = 0.05
    MAX_FEATURE_LR = 4.0
    MIN_FEATURE_LR = 0.25


def _odds(p: float) -> float:
    p = min(max(p, 1e-6), 1 - 1e-6)
    return p / (1 - p)


def _prob(o: float) -> float:
    return o / (1 + o)


def _evidence_lr(evidence_count: int, suspects_count: int,
                 status: str, priority: str) -> float:
    """
    Evidence-driven likelihood ratio. Replaces the original hardcoded
    per-type lookup so that evidence actually affects the score.
    """
    ev = 1.0 + 0.35 * np.log1p(max(0, evidence_count))
    su = 1.0 + 0.10 * max(0, suspects_count - 1)
    st = {"open": 1.05, "under investigation": 1.15,
          "pending trial": 1.25, "closed": 0.90}.get(status.lower(), 1.0)
    pr = {"high": 1.10, "medium": 1.00, "low": 0.90}.get(priority.lower(), 1.0)
    lr = float(ev * su * st * pr)
    return max(BayesianConfig.MIN_FEATURE_LR,
               min(BayesianConfig.MAX_FEATURE_LR, lr))


def bayesian_score(case: Dict[str, Any], current_year: int) -> Dict[str, Any]:
    ctype = str(case.get("type", "unknown")).lower()
    prior = BayesianConfig.PRIORS.get(ctype, 0.10)
    base_lr = BayesianConfig.BASE_LR.get(ctype, 1.0)

    ev_lr = _evidence_lr(
        coerce_int(case.get("evidence_count", 0), 0, 0, 10000),
        coerce_int(case.get("suspects_count", 0), 0, 0, 1000),
        str(case.get("status", "unknown")),
        str(case.get("priority", "medium")),
    )
    total_lr = base_lr * ev_lr
    posterior = _prob(_odds(prior) * total_lr)

    base_conf = coerce_float(case.get("confidence", 0.5), 0.5, 0.0, 1.0)
    year = coerce_int(case.get("year", current_year), current_year, 1900, 2100)
    age = max(0, current_year - year)
    decayed_conf = max(0.0, min(1.0,
        base_conf * exp(-BayesianConfig.AGE_DECAY_LAMBDA * age)))

    # FIX #8: decay now multiplies the posterior; it is not just a label.
    adjusted = posterior * (0.5 + 0.5 * decayed_conf)

    return {
        "posterior": float(posterior),
        "adjusted_posterior": float(adjusted),
        "confidence": float(decayed_conf),
        "prior_used": float(prior),
        "base_likelihood_ratio": float(base_lr),
        "evidence_likelihood_ratio": float(ev_lr),
        "risk_level": ("high" if adjusted > 0.70
                       else "medium" if adjusted > 0.40 else "low"),
    }


# =============================================================================
# MACHINE LEARNING  (FIX #1: proper Pipeline, single artifact, honest errors.)
# =============================================================================

CATEGORICAL = ["type", "status", "priority"]
# FIX #11: "location" removed from features -- it is a proxy for
# demographics/ethnicity and is not acceptable as a model input.
NUMERIC = ["year", "suspects_count", "evidence_count",
           "posterior", "confidence"]
TARGET = "label"


def build_pipeline() -> Pipeline:
    pre = ColumnTransformer(
        transformers=[
            ("cat", OneHotEncoder(handle_unknown="ignore",
                                  sparse_output=False), CATEGORICAL),
            ("num", StandardScaler(), NUMERIC),
        ],
        remainder="drop",
    )
    return Pipeline([
        ("pre", pre),
        ("clf", LogisticRegression(max_iter=2000, random_state=42)),
    ])


class MLModel:
    def __init__(self, path: Path):
        self.path = path
        self._pipe: Optional[Pipeline] = None
        self._meta: Dict[str, Any] = {}

    def exists(self) -> bool:
        return self.path.exists()

    def load(self) -> Pipeline:
        if self._pipe is None:
            if not self.exists():
                raise FileNotFoundError("Model not trained yet.")
            artifact = joblib.load(self.path)
            self._pipe = artifact["pipeline"]
            self._meta = artifact.get("meta", {})
        return self._pipe

    @property
    def meta(self) -> Dict[str, Any]:
        if not self._meta and self.exists():
            _ = self.load()
        return self._meta

    def train(self, df: pd.DataFrame) -> Dict[str, Any]:
        missing = [c for c in CATEGORICAL + NUMERIC + [TARGET]
                   if c not in df.columns]
        if missing:
            raise ValueError(f"Missing required columns: {missing}")

        df = df.dropna(subset=[TARGET]).copy()
        df[TARGET] = df[TARGET].astype(int)

        if df[TARGET].nunique() < 2:
            raise ValueError(
                "Training data must contain both classes (0 and 1).")
        # FIX #9: refuse undersized training sets rather than reporting
        # meaningless metrics (the original trained on 10 rows / 3 test).
        if len(df) < 20:
            raise ValueError(
                f"Refusing to train on {len(df)} rows; "
                "at least 20 are required for a meaningful split.")

        y = df[TARGET]
        X = df.drop(columns=[TARGET])
        counts = y.value_counts()
        strat = y if counts.min() >= 2 else None

        X_tr, X_te, y_tr, y_te = train_test_split(
            X, y, test_size=0.25, random_state=42, stratify=strat,
        )

        pipe = build_pipeline()
        pipe.fit(X_tr, y_tr)

        prob = pipe.predict_proba(X_te)[:, 1]
        pred = (prob >= 0.5).astype(int)
        report = classification_report(y_te, pred, output_dict=True,
                                       zero_division=0)

        metrics = {
            "roc_auc": (float(roc_auc_score(y_te, prob))
                        if y_te.nunique() > 1 else float("nan")),
            "accuracy": float((pred == y_te).mean()),
            "report": report,
            "training_samples": int(len(X_tr)),
            "test_samples": int(len(X_te)),
            "model_version": Config.MODEL_VERSION,
            "trained_at": datetime.utcnow().isoformat(),
        }
        artifact = {
            "pipeline": pipe,
            "meta": {
                "version": Config.MODEL_VERSION,
                "trained_at": metrics["trained_at"],
                "features": {"categorical": CATEGORICAL, "numeric": NUMERIC},
                "metrics": metrics,
            },
        }
        self.path.parent.mkdir(parents=True, exist_ok=True)
        joblib.dump(artifact, self.path)
        self._pipe, self._meta = pipe, artifact["meta"]
        return metrics

    def predict_one(self, case: Dict[str, Any],
                    bayes: Dict[str, Any]) -> Tuple[Optional[float], str]:
        """
        FIX #1: returns (probability, error_message). On any failure the
        caller surfaces the reason in the UI instead of silently using 0.5.
        Because the pipeline embeds OneHotEncoder(handle_unknown='ignore'),
        single-row prediction cannot fail from a column-count mismatch.
        """
        if not self.exists():
            return None, "ML model is not trained."
        try:
            pipe = self.load()
            X = pd.DataFrame([self._case_to_row(case, bayes)])[CATEGORICAL + NUMERIC]
            return float(pipe.predict_proba(X)[0, 1]), ""
        except Exception as exc:
            LOG.exception("ML prediction failed")
            return None, f"ML prediction failed: {exc}"

    @staticmethod
    def _case_to_row(case: Dict[str, Any],
                     bayes: Dict[str, Any]) -> Dict[str, Any]:
        return {
            "type": str(case.get("type", "unknown")).lower(),
            "status": str(case.get("status", "unknown")).lower(),
            "priority": str(case.get("priority", "medium")).lower(),
            "year": coerce_int(case.get("year", datetime.now().year),
                               datetime.now().year, 1900, 2100),
            "suspects_count": coerce_int(case.get("suspects_count", 0),
                                         0, 0, 1000),
            "evidence_count": coerce_int(case.get("evidence_count", 0),
                                         0, 0, 10000),
            "posterior": float(bayes["posterior"]),
            "confidence": float(bayes["confidence"]),
        }


