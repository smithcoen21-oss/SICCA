def admin_required(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        if not current_user.is_authenticated:
            return login_manager.unauthorized()
        if not current_user.is_admin():
            abort(403)
        return f(*args, **kwargs)
    return wrapper


class LoginThrottle:
    def __init__(self, window: int = 900):
        self.window = window

    def wait_seconds(self, key: str, limit: int) -> int:
        now = time.time()
        try:
            with db() as conn:
                conn.execute("DELETE FROM login_failure WHERE ts < ?", (now - self.window,))
                rows = conn.execute("SELECT ts FROM login_failure WHERE key = ? ORDER BY ts ASC", (key,)).fetchall()
        except sqlite3.Error:
            return 0
        if len(rows) < limit:
            return 0
        pivot = rows[len(rows) - limit]["ts"]
        return max(1, int(self.window - (now - pivot)))

    def fail(self, key: str) -> None:
        try:
            with db() as conn:
                conn.execute("INSERT INTO login_failure (key, ts) VALUES (?,?)", (key, time.time()))
        except sqlite3.Error:
            pass

    def clear(self, key: str) -> None:
        try:
            with db() as conn:
                conn.execute("DELETE FROM login_failure WHERE key = ?", (key,))
        except sqlite3.Error:
            pass


