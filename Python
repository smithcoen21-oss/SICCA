    @app.route("/admin/train", methods=["GET", "POST"])
    @admin_required
    def train_model():
        if request.method == "POST":
            f = request.files.get("training_csv")
            if not f or not f.filename.lower().endswith(".csv"):
                flash("Upload a .csv file.", "error")
                return _train_page(400)
            try:
                df = pd.read_csv(f.stream, nrows=200_000)
            except Exception:
                flash("Could not read that CSV file.", "error")
                return _train_page(400)
            try:
                m = ml.train(df)
            except ValueError as exc:
                flash(str(exc), "error")
                return _train_page(400)
            except Exception:
                ref = secrets.token_hex(4)
                LOG.exception("Training failed (ref %s)", ref)
                flash(f"Training failed. Reference: {ref}", "error")
                return _train_page(500)
            audit(current_user.username, "train_model", "model",
                  f"rows={m['training_samples'] + m['test_samples']} "
                  f"auc={m['roc_auc']}")
            auc = "n/a" if m["roc_auc"] is None else f"{m['roc_auc']:.3f}"
            flash(f"Model trained. Test AUC {auc}, accuracy "
                  f"{m['accuracy']:.3f} on {m['test_samples']} held-out "
                  "rows.", "success")
            return redirect(url_for("train_model"))
        return _train_page()

    def _train_page(status: int = 200):
        return render_template("train.html", model_meta=ml.meta,
                               min_rows=Config.MIN_TRAIN_ROWS), status

    return app


def _discard(path: Optional[Path]) -> None:
    if path is not None:
        try:
            path.unlink(missing_ok=True)
        except OSError:
            LOG.warning("Could not remove orphaned upload %s", path)


# =============================================================================
# CLI
# =============================================================================

def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="sicca_app.py")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("run", help="start the web server (default)")
    cu = sub.add_parser("create-user", help="add a user")
    cu.add_argument("username")
    cu.add_argument("--role", choices=["analyst", "admin"], default="analyst")
    tr = sub.add_parser("train", help="train the ML model from a CSV")
    tr.add_argument("csv")
    sub.add_parser("check-templates",
                   help="show where templates are found")
    tr2 = sub.add_parser("trace",
                         help="print the Bayesian arithmetic for one case")
    tr2.add_argument("case_id")
    args = parser.parse_args(argv)
    cmd = args.cmd or "run"

    if cmd == "check-templates":
        _, index = build_template_loader()
        for name in REQUIRED_TEMPLATES:
            print(f"{name:20s} -> "
                  f"{index.get(name, 'MISSING (built-in fallback)')}")
        extra = sorted(set(index) - set(REQUIRED_TEMPLATES))
        if extra:
            print("\nOther templates found:")
            for name in extra:
                print(f"  {name:28s} {index[name]}")
        return 0

    init_db()

    if cmd == "create-user":
        pw = getpass.getpass("Password: ")
        if pw != getpass.getpass("Repeat password: "):
            print("Passwords do not match.", file=sys.stderr)
            return 1
        try:
            create_user(args.username, pw, args.role)
        except (ValueError, sqlite3.IntegrityError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Created {args.role} '{args.username}'.")
        return 0

    if cmd == "train":
        model = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH)
        try:
            m = model.train(pd.read_csv(args.csv))
        except (ValueError, OSError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Trained v{m['model_version']}: AUC={m['roc_auc']} "
              f"accuracy={m['accuracy']:.3f} "
              f"(train {m['training_samples']}, test {m['test_samples']})")
        return 0

    if cmd == "trace":
        if calib is None:
            print(f"Calibration module unavailable: {_CALIB_IMPORT_ERROR}",
                  file=sys.stderr)
            return 1
        with db() as conn:
            row = conn.execute(
                "SELECT * FROM cases WHERE case_id = ?", (args.case_id,)
            ).fetchone()
        if row is None:
            print(f"No such case: {args.case_id}", file=sys.stderr)
            return 1
        trace = calib.trace_case(
            dict(row),
            base_prior=BayesianConfig.BASE_PRIOR,
            type_lr_map=BayesianConfig.TYPE_LR,
            status_lr_map={
                "open": 1.05, "under investigation": 1.15,
                "pending trial": 1.25, "closed": 0.90,
            },
            priority_lr_map={"high": 1.10, "medium": 1.00, "low": 0.90},
            age_decay_lambda=BayesianConfig.AGE_DECAY_LAMBDA,
            min_feature_lr=BayesianConfig.MIN_FEATURE_LR,
            max_feature_lr=BayesianConfig.MAX_FEATURE_LR,
            high_threshold=BayesianConfig.HIGH,
            medium_threshold=BayesianConfig.MEDIUM,
            current_year=datetime.now().year,
        )
        print(calib.trace_summary(trace))
        print()
        import json as _json
        print(_json.dumps(trace, indent=2, default=str))
        return 0

    if Config.DEBUG and Config.HOST not in LOOPBACK_HOSTS:
        print("Refusing to run with SICCA_DEBUG=1 on a non-loopback host: "
              "the Werkzeug debugger allows remote code execution.",
              file=sys.stderr)
        return 1
    create_app().run(host=Config.HOST, port=Config.PORT, debug=Config.DEBUG)
    return 0


if __name__ == "__main__":
    sys.exit(main())
''')


