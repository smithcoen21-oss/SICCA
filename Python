T["network_graph.html"] = """{% extends "_base.html" %}{% block body %}<h1>Case network 
graph</h1>
<div class="card"><form method="get" class="cols"><div>
<label>Prior probability (0.001 to 0.5)</label><input name="prior" value="{{ prior }}">
</div><div>
<label>Hide edges below (% posterior)</label><input name="floor" value="{{ floor }}">
</div><div style="align-self:end"><button class="btn">Recompute</button></div></form>
<p class="muted">{{ n_nodes }} case(s), {{ n_edges }} link(s) above threshold. Click a node to 
open the case; click an edge to open the pairwise comparison.</p>
</div>
<div class="card"><div id="graph"></div>
<p class="muted" style="margin-top:.6rem">Fully offline: this graph is drawn with inline SVG and 
vanilla JavaScript. No external files are loaded.</p>
</div>
<div class="card"><h3>Legend</h3><p class="muted">Node color = crime type. Node size = 
number of connections above threshold. Edge thickness/color = posterior strength (green = strong, 
red = weak). Hover for details.</p></div>
<script>
(function(){
  const nodes = {{ nodes_json|safe }};
  const edges = {{ edges_json|safe }};
  const svg = document.createElementNS('http://www.w3.org/2000/svg','svg');
  svg.setAttribute('viewBox','0 0 1000 650');
  svg.setAttribute('preserveAspectRatio','xMidYMid meet');
  document.getElementById('graph').appendChild(svg);
  const W=1000, H=650, cx=W/2, cy=H/2, R=Math.min(W,H)/2 - 60;
  const N = nodes.length;
  const positions = {};
  const degree = {};
  nodes.forEach(n=>degree[n.id]=0);
  edges.forEach(e=>{degree[e.from]=(degree[e.from]||0)+1;degree[e.to]=(degree[e.to]||0)+1;});
  nodes.forEach((n,i)=>{
    const angle = (2*Math.PI*i)/Math.max(N,1);
    positions[n.id] = {x: cx + R*Math.cos(angle), y: cy + R*Math.sin(angle), deg: degree[n.id]||0};
  });
  const typeColor = t => ({
    fraud:'#3b82f6', homicide:'#ef4444', robbery:'#f59e0b', arson:'#f97316',
    burglary:'#a855f7', assault:'#ec4899', theft:'#14b8a6',
    vandalism:'#84cc16', unknown:'#94a3b8'
  }[t] || '#94a3b8');
  edges.forEach(e=>{
    const a = positions[e.from], b = positions[e.to];
    if(!a||!b) return;
    const line = document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1',a.x); line.setAttribute('y1',a.y);
    line.setAttribute('x2',b.x); line.setAttribute('y2',b.y);
    line.setAttribute('stroke', e.color);
    line.setAttribute('stroke-opacity', Math.max(0.25, Math.min(1, e.value/100)));
    line.setAttribute('stroke-width', Math.max(1, Math.min(8, e.value/8)));
    line.classList.add('edge');
    const title = document.createElementNS('http://www.w3.org/2000/svg','title');
    title.textContent = e.title;
    line.appendChild(title);
    line.addEventListener('click', ()=>{ if(e.url) window.location = e.url; });
    svg.appendChild(line);
  });
  nodes.forEach(n=>{
    const p = positions[n.id];
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    const size = 12 + Math.min(14, (p.deg||0)*2);
    c.setAttribute('cx',p.x); c.setAttribute('cy',p.y);
    c.setAttribute('r',size);
    c.setAttribute('fill', typeColor(n.group));
    c.addEventListener('click', ()=>{ if(n.url) window.location = n.url; });
    const title = document.createElementNS('http://www.w3.org/2000/svg','title');
    title.textContent = n.title;
    c.appendChild(title);
    g.appendChild(c);
    const t = document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x',p.x); t.setAttribute('y',p.y + size + 14);
    t.setAttribute('text-anchor','middle');
    t.textContent = n.id;
    g.appendChild(t);
    svg.appendChild(g);
  });
})();
</script>
{% endblock %}"""
