    def parse_prior(v) -> float:

        try:

            return min(0.5, max(0.001, float(v)))

        except (TypeError, ValueError):

            return Config.DEFAULT_PRIOR



    @app.route("/cross_match")

    @login_required

    def compare():

        a, b = clean(request.args.get("a"), 50), clean(request.args.get("b"), 50)

        prior = parse_prior(request.args.get("prior"))

        ctx: Dict[str, Any] = {"prior": prior, "sel_a": a, "sel_b": b, "r": None,

                               "cats": CATEGORIES, "statuses": STATUS_W}

        with db() as c:

            ctx["cases"] = [dict(r) for r in c.execute("SELECT case_id,case_name FROM cases ORDER BY modified DESC")]

            if a and b:

                if a == b:

                    ctx["error"] = "Choose two different cases."

                else:

                    A, B = get_case(c, a), get_case(c, b)

                    r = assess(pair_items(c, A, B), prior, seed="|".join(sorted((a, b))))

                    model = load_calibration()

                    ctx.update(r=r, A=A, B=B, base=baseline(c, r["total_log"]),

                               cal=calibrated(r["post"], model), cal_on=bool(model),

                               warns=fact_check(A, victims_of(c, a)) + fact_check(B, victims_of(c, b)))

        return render_template("compare.html", **ctx)



    @app.route("/matrix")

    @login_required

    def matrix():

        prior = parse_prior(request.args.get("prior"))

        try:

            floor = float(request.args.get("floor", 5.0))

        except (TypeError, ValueError):

            floor = 5.0

        floor = max(0.0, min(100.0, floor))

        with db() as c:

            cases = [dict(r) for r in c.execute("SELECT case_id,case_name FROM cases ORDER BY case_id")]

            scores = pairwise_scores(c, prior)

        cell: Dict[tuple, Dict[str, float]] = {}

        row_max: Dict[str, float] = {cs["case_id"]: 0.0 for cs in cases}

        global_max = 0.0

        for (a, b), r in scores.items():

            pct = r["post"] * 100.0

            cell[(a, b)] = {"pct": pct, "p5": r["p5"] * 100.0,

                            "p95": r["p95"] * 100.0, "lr": r["combined_lr"]}

            if pct > row_max.get(a, 0):

                row_max[a] = pct

            if pct > row_max.get(b, 0):

                row_max[b] = pct

            if pct > global_max:

                global_max = pct

        cases.sort(key=lambda cs: -row_max.get(cs["case_id"], 0.0))

        return render_template("matrix.html", cases=cases, cell=cell, prior=prior,

                               floor=floor, row_max=row_max, global_max=global_max)



    @app.route("/network_graph")

    @login_required

    def network_graph():

        prior = parse_prior(request.args.get("prior"))

        try:

            floor = float(request.args.get("floor", 10.0))

        except (TypeError, ValueError):

            floor = 10.0

        floor = max(0.0, min(100.0, floor))

        with db() as c:

            cases = [dict(r) for r in c.execute("SELECT case_id,case_name,type,status,priority FROM cases ORDER BY case_id")]

            scores = pairwise_scores(c, prior)

        nodes = [{"id": cs["case_id"],

                  "label": cs["case_id"],

                  "title": f"{cs['case_id']}: {cs['case_name']} | Type: {cs['type']} | Status: {cs['status']} | Priority: {cs['priority']}",

                  "group": cs["type"],

                  "url": url_for("view_case", case_id=cs["case_id"])} for cs in cases]

        edges = []

        for (a, b), r in scores.items():

            pct = r["post"] * 100.0

            if pct < floor:

                continue

            hue = 120 * (1 - min(1.0, pct / 100.0))

            edges.append({"from": a, "to": b, "value": pct,

                          "title": f"{a} and {b}: {pct:.1f}% posterior, LR {r['combined_lr']:.2f}x",

                          "url": url_for("compare", a=a, b=b, prior=prior),

                          "color": f"hsl({hue:.0f},65%,50%)"})

        return render_template("network_graph.html", prior=prior, floor=floor,

                               n_nodes=len(nodes), n_edges=len(edges),

                               nodes_json=json.dumps(nodes), edges_json=json.dumps(edges))



    @app.route("/evidence")

    @login_required

    def evidence_library():

        status = clean(request.args.get("status"), 20)

        cat = clean(request.args.get("category"), 40)

        q = clean(request.args.get("q"), 100)

        min_lr = request.args.get("min_lr", "")

        grp = clean(request.args.get("grp"), 40)

        sql = ("SELECT e.*, a.case_name AS a_name, b.case_name AS b_name "

               "FROM link_evidence e "

               "LEFT JOIN cases a ON a.case_id = e.case_a "

               "LEFT JOIN cases b ON b.case_id = e.case_b "

               "WHERE 1=1")

        params: List[Any] = []

        if status and status in STATUS_W:

            sql += " AND e.status = ?"; params.append(status)

        if cat and cat in CATEGORIES:

            sql += " AND e.category = ?"; params.append(cat)

        if grp:

            sql += " AND e.grp = ?"; params.append(grp)

        if q:

            sql += " AND (e.description LIKE ? OR e.source LIKE ? OR e.created_by LIKE ?)"

            like = f"%{q}%"; params += [like, like, like]

        if min_lr:

            try:

                v = float(min_lr); sql += " AND e.lr >= ?"; params.append(v)

            except ValueError:

                pass

        sql += " ORDER BY e.created DESC LIMIT 500"

        with db() as c:

            rows = [dict(r) for r in c.execute(sql, params).fetchall()]

        return render_template("evidence_library.html", rows=rows, cats=CATEGORIES,

                               statuses=STATUS_W, f={"status": status, "category": cat,

                               "q": q, "min_lr": min_lr, "grp": grp})



