            continue
        hue = 120 * (1 - min(1.0, pct / 100.0))
        edges.append({"from": a, "to": b, "value": pct,
                      "title": f"{a} and {b}: {pct:.1f}% posterior, LR {r['combined_lr']:.2f}x",
                      "url": url_for("compare", a=a, b=b, prior=prior),
                      "color": f"hsl({hue:.0f},65%,50%)"})
    return render_template("network_graph.html", prior=prior, floor=floor,
                           n_nodes=len(nodes), n_edges=len(edges),
                           nodes_json=json.dumps(nodes), edges_json=json.dumps(edges))

@app.route("/evidence")
@login_required
def evidence_library():
    status = clean(request.args.get("status"), 20)
    cat = clean(request.args.get("category"), 40)
    q = clean(request.args.get("q"), 100)
    min_lr = request.args.get("min_lr", "")
    grp = clean(request.args.get("grp"), 40)
    sql = ("SELECT e.*, a.case_name AS a_name, b.case_name AS b_name "
           "FROM link_evidence e "
           "LEFT JOIN cases a ON a.case_id = e.case_a "
           "LEFT JOIN cases b ON b.case_id = e.case_b "
           "WHERE 1=1")
    params: List[Any] = []
    if status and status in STATUS_W:
        sql += " AND e.status = ?"; params.append(status)
    if cat and cat in CATEGORIES:
        sql += " AND e.category = ?"; params.append(cat)
    if grp:
        sql += " AND e.grp = ?"; params.append(grp)
    if q:
        sql += " AND (e.description LIKE ? OR e.source LIKE ? OR e.created_by LIKE ?)"
        like = f"%{q}%"; params += [like, like, like]
    if min_lr:
        try:
            v = float(min_lr); sql += " AND e.lr >= ?"; params.append(v)
        except ValueError:
            pass
    sql += " ORDER BY e.created DESC LIMIT 500"
    with db() as c:
        rows = [dict(r) for r in c.execute(sql, params).fetchall()]
    return render_template("evidence_library.html", rows=rows, cats=CATEGORIES,
                           statuses=STATUS_W, f={"status": status, "category": cat,
                           "q": q, "min_lr": min_lr, "grp": grp})

