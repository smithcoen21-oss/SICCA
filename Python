# =============================================================================
# CALIBRATION HELPERS
# =============================================================================

def calib_common_kwargs(current_year: int) -> Dict[str, Any]:
    return dict(
        status_lr_map=BayesianConfig.STATUS_LR,
        priority_lr_map=BayesianConfig.PRIORITY_LR,
        age_decay_lambda=BayesianConfig.AGE_DECAY_LAMBDA,
        min_feature_lr=BayesianConfig.MIN_FEATURE_LR,
        max_feature_lr=BayesianConfig.MAX_FEATURE_LR,
        high_threshold=BayesianConfig.HIGH,
        medium_threshold=BayesianConfig.MEDIUM,
        current_year=current_year,
    )


def build_trace(case: Dict[str, Any]) -> Any:
    """Run the calibration trace and attach the score the app really uses,
    so any difference between the two is visible instead of silent."""
    year = datetime.now().year
    trace = calib.trace_case(
        case,
        base_prior=BayesianConfig.BASE_PRIOR,
        type_lr_map=BayesianConfig.TYPE_LR,
        **calib_common_kwargs(year),
    )
    if isinstance(trace, dict):
        trace["sicca_app_score"] = bayesian_score(case, year)
    return trace


