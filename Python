# CROSS-CASE MATCHING ENGINE (Restored from v2.1)
# =============================================================================

TRIGGER_RE = re.compile(
    r"\b(similar\w*|compare|comparison|match\w*|link\w*|connect\w*|"
    r"cross[\s\-]?match|cross[\s\-]?reference)\b", re.I)

MATCH_WEIGHTS = {"suspects": 0.20, "evidence": 0.15, "description": 0.15,
                 "type": 0.10, "location": 0.15, "tags": 0.10,
                 "year": 0.10, "assigned_to": 0.05}
HARD_LINK_FLOOR = 0.50
SOFT_VALUE = 0.6
MAX_MATCH_CASES = 20
MAX_YEAR_GAP = 10


def _tokens(text: str) -> set:
    return {t for t in re.split(r"[^a-z0-9]+", (text or "").lower()) if t}


def _jaccard(a: set, b: set) -> float:
    return len(a & b) / len(a | b) if a and b else 0.0


def _tag_set(tags: str) -> set:
    return {t.strip().lower() for t in (tags or "").split(",") if t.strip()}


def _text_similarity(a: str, b: str) -> float:
    a, b = (a or "").strip(), (b or "").strip()
    if not a or not b:
        return 0.0
    try:
        m = TfidfVectorizer(stop_words="english").fit_transform([a, b])
        return float(cosine_similarity(m[0], m[1])[0, 0])
    except ValueError:
        return 0.0


def _norm_key(text: str) -> str:
    return " ".join(sorted(_tokens(text)))


def _norm_ident(text: str) -> str:
    return re.sub(r"[^a-z0-9]", "", (text or "").lower())


def _suspect_keys(s: Dict[str, Any]) -> set:
    keys = {_norm_key(s.get("name", ""))}
    keys |= {_norm_key(x) for x in (s.get("aliases") or "").split(",")}
    keys.discard("")
    return keys


def match_records(ra: List[Dict[str, Any]], rb: List[Dict[str, Any]],
                  kind: str) -> Tuple[float, List[str], bool]:
    used: set = set()
    total, notes, hard_any = 0.0, [], False
    for x in ra:
        for j, y in enumerate(rb):
            if j in used:
                continue
            ix, iy = _norm_ident(x.get("identifier")), _norm_ident(y.get("identifier"))
            hard = bool(ix) and ix == iy
            if kind == "suspect":
                soft = bool(_suspect_keys(x) & _suspect_keys(y))
                label = f"{x.get('name', '')} / {y.get('name', '')}"
                what = "suspect"
            else:
                soft = (x.get("kind") == y.get("kind") and
                        _norm_key(x.get("label", "")) == _norm_key(y.get("label", "")) and
                        bool(_norm_key(x.get("label", ""))))
                label = f"{x.get('label', '')}"
                what = "evidence"
            if hard:
                used.add(j); total += 1.0; hard_any = True
                notes.append(f"HARD LINK - same {what} identifier ({x.get('identifier')}): {label}")
                break
            if soft:
                used.add(j); total += SOFT_VALUE
                notes.append(f"Possible same {what} (name/label match only): {label}")
                break
    denom = max(1, min(len(ra), len(rb)))
    return min(1.0, total / denom), notes, hard_any


def compare_cases(a: Dict[str, Any], b: Dict[str, Any]) -> Dict[str, Any]:
    shared: List[str] = []
    ta, tb = str(a.get("type", "")).lower(), str(b.get("type", "")).lower()
    type_s = 1.0 if ta and ta == tb else 0.0
    if type_s:
        shared.append(f"Same crime type: {a.get('type')}")

    la, lb = str(a.get("location", "")).lower(), str(b.get("location", "")).lower()
    if la and la == lb:
        loc_s = 1.0
        shared.append(f"Same location: {a.get('location')}")
    else:
        loc_s = _jaccard(_tokens(la), _tokens(lb))
        if loc_s:
            shared.append(f"Overlapping location: {a.get('location')} / {b.get('location')}")

    sa, sb = _tag_set(a.get("tags")), _tag_set(b.get("tags"))
    tag_s = _jaccard(sa, sb)
    if sa & sb:
        shared.append("Shared tags: " + ", ".join(sorted(sa & sb)))

    try:
        gap = abs(int(a.get("year", 0)) - int(b.get("year", 0)))
    except (TypeError, ValueError):
        gap = MAX_YEAR_GAP
    year_s = max(0.0, 1.0 - gap / MAX_YEAR_GAP)
    if gap <= 2:
        shared.append(f"Close in time ({gap} year(s) apart)")

    aa, ab = str(a.get("assigned_to", "")).lower(), str(b.get("assigned_to", "")).lower()
    asg_s = 1.0 if aa and aa == ab else 0.0
    if asg_s:
        shared.append(f"Same investigator: {a.get('assigned_to')}")

    desc_s = _text_similarity(a.get("description"), b.get("description"))
    if desc_s >= 0.3:
        shared.append(f"Descriptions are textually similar ({desc_s:.0%})")

    breakdown = {"description": desc_s, "type": type_s, "location": loc_s,
                 "tags": tag_s, "year": year_s, "assigned_to": asg_s}
    hard_links: List[str] = []
    
    sus_a, sus_b = a.get("suspects") or [], b.get("suspects") or []
    if sus_a and sus_b:
        s_score, s_notes, s_hard = match_records(sus_a, sus_b, "suspect")
        breakdown["suspects"] = s_score
        shared += s_notes
        hard_links += [n for n in s_notes if n.startswith("HARD")]
    
    ev_a, ev_b = a.get("evidence") or [], b.get("evidence") or []
    if ev_a and ev_b:
        e_score, e_notes, e_hard = match_records(ev_a, ev_b, "evidence")
        breakdown["evidence"] = e_score
        shared += e_notes
        hard_links += [n for n in e_notes if n.startswith("HARD")]

    active = {k: MATCH_WEIGHTS[k] for k in breakdown}
    score = sum(active[k] * breakdown[k] for k in active) / sum(active.values())
    if hard_links:
        score = max(score, HARD_LINK_FLOOR)
    level = "strong" if score >= 0.65 else "moderate" if score >= 0.40 else "weak"
    return {"case_a": a.get("case_id"), "case_b": b.get("case_id"),
            "similarity": round(score, 3), "level": level, "shared": shared,
            "hard_links": hard_links,
            "breakdown": {k: round(v, 3) for k, v in breakdown.items()},
            "method": "weighted_heuristic"}


def cross_match(cases: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    res = [compare_cases(a, b) for a, b in combinations(cases, 2)]
    return sorted(res, key=lambda r: r["similarity"], reverse=True)


