def create_app() -> Flask:
    Config.ensure_dirs()
    init_db()
    check_risk_reachability()

    app = Flask(__name__, template_folder=None,
                static_folder=str(Config.APP_ROOT / "static"))
    loader, _ = build_template_loader()
    app.jinja_loader = loader  # must be set before the first render

    app.config.update(
        SECRET_KEY=load_or_create_secret_key(),
        MAX_CONTENT_LENGTH=Config.MAX_CONTENT_LENGTH,
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_COOKIE_SECURE=Config.COOKIE_SECURE,
        PERMANENT_SESSION_LIFETIME=Config.SESSION_LIFETIME_SECONDS,
        WTF_CSRF_ENABLED=True,
    )
    CSRFProtect(app)
    login_manager.init_app(app)
    login_manager.login_view = "login"

    ml = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH)
    engine = HybridEngine(ml)

    # ------------------------------------------------------------ helpers
    def can_access(row: sqlite3.Row) -> bool:
        if current_user.is_admin():
            return True
        me = current_user.username.lower()
        return (row["created_by"].lower() == me
                or (row["assigned_to"] or "").lower() == me)

    def scope() -> Tuple[str, Tuple[Any, ...]]:
        """SQL WHERE fragment limiting rows to what the user may see."""
        if current_user.is_admin():
            return "1=1", ()
        me = current_user.username.lower()
        return "(LOWER(created_by) = ? OR LOWER(assigned_to) = ?)", (me, me)

    def fetch_case(case_id: str) -> sqlite3.Row:
        ok, _ = validate_case_id(case_id)
        if not ok:
            abort(404)
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?",
                               (case_id,)).fetchone()
        # 404 (not 403) so unauthorised users cannot probe which IDs exist.
        if row is None or not can_access(row):
            abort(404)
        return row

    def render_create(status: int = 200, **extra):
        return render_template(
            "create_case.html", form=request.form if request.method == "POST"
            else {}, types=CASE_TYPES, statuses=STATUSES,
            priorities=PRIORITIES, **extra), status

    # ------------------------------------------------------------ hooks
    @app.after_request
    def security_headers(resp):
        resp.headers.setdefault("X-Content-Type-Options", "nosniff")
        resp.headers.setdefault("X-Frame-Options", "DENY")
        resp.headers.setdefault("Referrer-Policy", "same-origin")
        if current_user.is_authenticated:
            resp.headers["Cache-Control"] = "no-store"
        return resp

    @app.errorhandler(CSRFError)
    def csrf_error(_exc):
        return ("Security token missing or expired. Go back, reload the "
                "page and try again.", 400)

    @app.errorhandler(413)
    def too_large(_exc):
        mb = Config.MAX_CONTENT_LENGTH // (1024 * 1024)
        return f"Upload too large (limit {mb} MB).", 413

    # ------------------------------------------------------------ auth
    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect(url_for("dashboard"))
        if request.method == "POST":
            username = clean_text(request.form.get("username"), 100)
            password = request.form.get("password", "")
            ip = request.remote_addr or "?"
            k_user, k_ip = f"u:{ip}|{username.lower()}", f"ip:{ip}"
            wait = max(THROTTLE.wait_seconds(k_user, 5),
                       THROTTLE.wait_seconds(k_ip, 30))
            if wait:
                flash(f"Too many failed attempts. Try again in "
                      f"{wait // 60 + 1} minute(s).", "error")
                return render_template("login.html"), 429

            with db() as conn:
                row = conn.execute(
                    "SELECT id, username, password, role FROM users "
                    "WHERE username = ?", (username,)).fetchone()
            valid = check_password_hash(
                row["password"] if row else _DUMMY_HASH, password)
            if row and valid:
                THROTTLE.clear(k_user)
                session.clear()  # avoid session fixation
                login_user(User(row["id"], row["username"], row["role"]))
                session.permanent = True
                audit(row["username"], "login", row["username"])
                return redirect(url_for("dashboard"))

            THROTTLE.fail(k_user)
            THROTTLE.fail(k_ip)
            LOG.warning("Failed login for '%s' from %s", username[:50], ip)
            flash("Invalid credentials", "error")
            return render_template("login.html"), 401
        return render_template("login.html")

    @app.route("/logout", methods=["POST"])
    @login_required
    def logout():
        audit(current_user.username, "logout", current_user.username)
        logout_user()
        session.clear()
        return redirect(url_for("login"))

    # ------------------------------------------------------------ dashboard
    @app.route("/")
    @login_required
    def index():
        return redirect(url_for("dashboard"))

    @app.route("/dashboard")
    @login_required
    def dashboard():
        try:
            page = max(1, int(request.args.get("page", "1")))
        except ValueError:
            page = 1
        where, params = scope()
        size = Config.PAGE_SIZE
        with db() as conn:
            rows = conn.execute(
                f"SELECT * FROM cases WHERE {where} "
                "ORDER BY modified DESC LIMIT ? OFFSET ?",
                params + (size + 1, (page - 1) * size)).fetchall()
            total = conn.execute(
                f"SELECT COUNT(*) AS n FROM cases WHERE {where}",
                params).fetchone()["n"]
            open_n = conn.execute(
                f"SELECT COUNT(*) AS n FROM cases WHERE {where} "
                "AND LOWER(status) = 'open'", params).fetchone()["n"]
            high_n = conn.execute(
                f"SELECT COUNT(*) AS n FROM cases WHERE {where} "
                "AND LOWER(priority) = 'high'", params).fetchone()["n"]
        return render_template(
            "dashboard.html",
            cases=[dict(r) for r in rows[:size]],
            stats={"total_cases": total, "open_cases": open_n,
                   "high_priority": high_n},
            model_available=ml.exists(),
            page=page, has_more=len(rows) > size)

    # ------------------------------------------------------------ create
    @app.route("/create_case", methods=["GET", "POST"])
    @login_required
    def create_case():
        if request.method == "GET":
            return render_create()

        saved_path: Optional[Path] = None
        try:
            case_id = clean_text(request.form.get("case_id"), 50)
            ok, msg = validate_case_id(case_id)
            if not ok:
                raise FormError(msg)
            record = build_case_record(request.form, case_id,
                                       current_user.username)
            upload = prepare_upload(request.files.get("case_file"), case_id)
        except FormError as exc:
            flash(str(exc), "error")
            return render_create(400)

        with db() as conn:
            if conn.execute("SELECT 1 FROM cases WHERE case_id = ?",
                            (case_id,)).fetchone():
                flash("Case ID already exists", "error")
                return render_create(409)

        try:
            if upload:
                file, stored, display = upload
                saved_path = Config.UPLOADS_DIR / stored
                file.save(saved_path)
                record["attached_file"] = display
                record["file_path"] = stored  # relative to UPLOADS_DIR
            with db() as conn:
                conn.execute(
                    """INSERT INTO cases (case_id, case_name, location, year,
                    type, status, confidence, suspects_count, evidence_count,
                    description, priority, assigned_to, tags, attached_file,
                    file_path, created_by, created, modified)
                    VALUES (:case_id, :case_name, :location, :year, :type,
                    :status, :confidence, :suspects_count, :evidence_count,
                    :description, :priority, :assigned_to, :tags,
                    :attached_file, :file_path, :created_by, :created,
                    :modified)""", record)
                audit(current_user.username, "create_case", case_id,
                      conn=conn)
        except sqlite3.IntegrityError:  # lost a race on the primary key
            _discard(saved_path)
            flash("Case ID already exists", "error")
            return render_create(409)
        except Exception:
            _discard(saved_path)
            ref = secrets.token_hex(4)
            LOG.exception("Failed to save case %s (ref %s)", case_id, ref)
            flash(f"Could not save the case. Reference: {ref}", "error")
            return render_create(500)

        flash(f"Case {case_id} created.", "success")
        return redirect(url_for("view_case", case_id=case_id))

    # ------------------------------------------------------------ view
    @app.route("/case/<case_id>")
    @login_required
    def view_case(case_id: str):
        return render_template("view_case.html",
                               case=dict(fetch_case(case_id)))

    @app.route("/case/<case_id>/file")
    @login_required
    def download_file(case_id: str):
        row = fetch_case(case_id)
        if not row["file_path"]:
            abort(404)
        root = Config.UPLOADS_DIR.resolve()
        target = (root / row["file_path"]).resolve()
        if root not in target.parents or not target.is_file():
            abort(404)
        audit(current_user.username, "download_file", case_id)
        return send_file(target, as_attachment=True,
                         download_name=row["attached_file"] or target.name)

    # ------------------------------------------------------------ analysis
    @app.route("/analyze/<case_id>")
    @login_required
    def analyze_case(case_id: str):
        row = fetch_case(case_id)
        result = engine.analyze(dict(row))
        if request.args.get("format") == "json":
            return jsonify(result)
        return render_template("analysis.html", case=dict(row), result=result)

    @app.route("/export/<case_id>.json")
    @login_required
    def export_json(case_id: str):
        row = fetch_case(case_id)
        payload = {"case": {k: v for k, v in dict(row).items()
                            if k != "file_path"},
                   "analysis": engine.analyze(dict(row))}
        audit(current_user.username, "export_json", case_id)
        resp = jsonify(payload)
        resp.headers["Content-Disposition"] = (
            f'attachment; filename="{secure_filename(case_id)}.json"')
        return resp

    # ------------------------------------------------------------ admin
    @app.route("/admin/train", methods=["GET", "POST"])
    @admin_required
    def train_model():
        if request.method == "POST":
            f = request.files.get("training_csv")
            if not f or not f.filename.lower().endswith(".csv"):
                flash("Upload a .csv file.", "error")
                return _train_page(400)
            try:
                df = pd.read_csv(f.stream, nrows=200_000)
            except Exception:
                flash("Could not read that CSV file.", "error")
                return _train_page(400)
            try:
                m = ml.train(df)
            except ValueError as exc:
                flash(str(exc), "error")
                return _train_page(400)
            except Exception:
                ref = secrets.token_hex(4)
                LOG.exception("Training failed (ref %s)", ref)
                flash(f"Training failed. Reference: {ref}", "error")
                return _train_page(500)
            audit(current_user.username, "train_model", "model",
                  f"rows={m['training_samples'] + m['test_samples']} "
                  f"auc={m['roc_auc']}")
            auc = "n/a" if m["roc_auc"] is None else f"{m['roc_auc']:.3f}"
            flash(f"Model trained. Test AUC {auc}, accuracy "
                  f"{m['accuracy']:.3f} on {m['test_samples']} held-out "
                  "rows.", "success")
            return redirect(url_for("train_model"))
        return _train_page()

    def _train_page(status: int = 200):
        return render_template("train.html", model_meta=ml.meta,
                               min_rows=Config.MIN_TRAIN_ROWS), status

    return app


def _discard(path: Optional[Path]) -> None:
    """Remove a just-saved upload after a failed insert."""
    if path is not None:
        try:
            path.unlink(missing_ok=True)
        except OSError:
            LOG.warning("Could not remove orphaned upload %s", path)


# =============================================================================
# CLI
# =============================================================================

def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="sicca_app.py")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("run", help="start the web server (default)")
    cu = sub.add_parser("create-user", help="add a user")
    cu.add_argument("username")
    cu.add_argument("--role", choices=["analyst", "admin"], default="analyst")
    tr = sub.add_parser("train", help="train the ML model from a CSV")
    tr.add_argument("csv")
    sub.add_parser("check-templates", help="show where templates are found")
    args = parser.parse_args(argv)
    cmd = args.cmd or "run"

    if cmd == "check-templates":
        _, index = build_template_loader()
        for name in REQUIRED_TEMPLATES:
            print(f"{name:20s} -> {index.get(name, 'MISSING (built-in fallback)')}")
        extra = sorted(set(index) - set(REQUIRED_TEMPLATES))
        if extra:
            print("\nOther templates found:")
            for name in extra:
                print(f"  {name:28s} {index[name]}")
        return 0

    init_db()

    if cmd == "create-user":
        pw = getpass.getpass("Password: ")
        if pw != getpass.getpass("Repeat password: "):
            print("Passwords do not match.", file=sys.stderr)
            return 1
        try:
            create_user(args.username, pw, args.role)
        except (ValueError, sqlite3.IntegrityError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Created {args.role} '{args.username}'.")
        return 0

    if cmd == "train":
        model = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH)
        try:
            m = model.train(pd.read_csv(args.csv))
        except (ValueError, OSError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Trained v{m['model_version']}: AUC={m['roc_auc']} "
              f"accuracy={m['accuracy']:.3f} "
              f"(train {m['training_samples']}, test {m['test_samples']})")
        return 0

    # run
    if Config.DEBUG and Config.HOST not in LOOPBACK_HOSTS:
        print("Refusing to run with SICCA_DEBUG=1 on a non-loopback host: "
              "the Werkzeug debugger allows remote code execution.",
              file=sys.stderr)
        return 1
    create_app().run(host=Config.HOST, port=Config.PORT, debug=Config.DEBUG)
    return 0


if __name__ == "__main__":
    sys.exit(main())
