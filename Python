STATUS_W = {"verified": 1.0, "witness": 0.5, "unverified": 0.25, "disputed": 0.1}





def effective(it: Dict[str, Any]) -> Dict[str, Any]:

    w = STATUS_W.get(it["status"], 0.25) * max(0.0, min(1.0, float(it["reliability"])))

    it["w"] = w

    it["elr"] = math.exp(math.log(max(float(it["lr"]), 1e-6)) * w)

    return it





def group_best(items: List[Dict[str, Any]]) -> Dict[str, tuple]:

    best: Dict[str, tuple] = {}

    for i, it in enumerate(items):

        key = it.get("grp") or f"_item{i}"

        ll = math.log(it["elr"])

        if key not in best or abs(ll) > abs(best[key][0]):

            best[key] = (ll, i)

    return best





def to_p(prior: float, sum_log: float) -> float:

    odds = prior / (1 - prior) * math.exp(max(-50.0, min(50.0, sum_log)))

    return odds / (1 + odds)





def assess(items: List[Dict[str, Any]], prior: float, seed: str = "") -> Dict[str, Any]:

    items = [effective(dict(i)) for i in items]

    best = group_best(items)

    total = sum(v[0] for v in best.values())

    post = to_p(prior, total)

    rng = random.Random(seed)

    sds = {k: 0.15 + 0.5 * (1 - items[v[1]]["w"]) for k, v in best.items()}

    samples = []

    for _ in range(Config.MC_SAMPLES):

        pr = min(0.9, max(1e-4, prior * math.exp(rng.gauss(0, 0.5))))

        samples.append(to_p(pr, sum(v[0] + rng.gauss(0, sds[k]) for k, v in best.items())))

    samples.sort()

    sens = []

    for k, v in best.items():

        it = items[v[1]]

        sens.append({"desc": it["description"], "delta": post - to_p(prior, total - v[0]), "counted": True})

    sens.sort(key=lambda s: -abs(s["delta"]))

    counted = {v[1] for v in best.values()}

    for i, it in enumerate(items):

        it["counted"] = i in counted

    return {"items": items, "total_log": total, "combined_lr": math.exp(max(-50, min(50, total))),

            "prior": prior, "post": post,

            "p5": samples[int(0.05 * len(samples))],

            "p95": samples[int(0.95 * len(samples)) - 1],

            "sens": sens}





def tokens(s: str) -> set:

    return {t for t in re.findall(r"[a-zà-ÿ]{4,}", (s or "").lower())}





def auto_items(a: Dict[str, Any], b: Dict[str, Any]) -> List[Dict[str, Any]]:

    out = []

    base = {"source": "case records", "status": "verified", "reliability": 0.5, "auto": True, "id": None}

    if a["type"] == b["type"] and a["type"] != "unknown":

        out.append({**base, "category": "victim_profile", "lr": 1.2, "grp": "auto_type",

                    "description": f"Same crime type ({a['type']})"})

    shared = tokens(a["location"]) & tokens(b["location"])

    if shared:

        out.append({**base, "category": "shared_region", "lr": CATEGORIES["shared_region"][0],

                    "grp": "auto_region",

                    "description": "Location text overlap: " + ", ".join(sorted(shared))})

    gap = abs(int(a["year"]) - int(b["year"]))

    if gap > 3:

        out.append({**base, "category": "time_gap", "lr": 0.7, "grp": "auto_time",

                    "reliability": 1.0, "description": f"{gap} years between the cases"})

    return out





def pair_items(conn, a: Dict[str, Any], b: Dict[str, Any]) -> List[Dict[str, Any]]:

    x, y = sorted((a["case_id"], b["case_id"]))

    rows = conn.execute("SELECT * FROM link_evidence WHERE case_a=? AND case_b=? ORDER BY id",

                        (x, y)).fetchall()

    return auto_items(a, b) + [dict(r, auto=False) for r in rows]





def baseline(conn, total_log: float) -> Dict[str, Any]:

    cases = [dict(r) for r in conn.execute("SELECT * FROM cases").fetchall()]

    scores = []

    for a, b in combinations(cases, 2):

        it = [effective(dict(i)) for i in pair_items(conn, a, b)]

        scores.append(sum(v[0] for v in group_best(it).values()) if it else 0.0)

    n = len(scores)

    below = sum(1 for s in scores if s < total_log - 1e-9)

    return {"n": n, "pct": (100.0 * below / n) if n else None}





def pairwise_scores(conn, prior: float) -> Dict[tuple, Dict[str, Any]]:

    """Compute assess() for every pair of cases. Used by the matrix and graph views."""

    cases = [dict(r) for r in conn.execute("SELECT * FROM cases").fetchall()]

    out: Dict[tuple, Dict[str, Any]] = {}

    for a, b in combinations(cases, 2):

        key = tuple(sorted((a["case_id"], b["case_id"])))

        try:

            out[key] = assess(pair_items(conn, a, b), prior, seed="|".join(key))

        except Exception as e:

            LOG.warning("pairwise assess failed for %s: %s", key, e)

    return out





NUMWORDS = {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6}





def fact_check(case: Dict[str, Any], victims: List[Dict[str, Any]]) -> List[str]:

    out, text, n = [], (case["description"] or "").lower(), len(victims)

    sexes = {v["sex"] for v in victims}

    if not n:

        out.append("No victims recorded; comparisons on victim profile are unsupported.")

    if (re.search(r"\b(three|two|four|all|\d+)\s+(teenage\s+)?(female|girls|women)\b", text)

            and "M" in sexes

            and not re.search(r"\b(boy|boys|male|man|men)\b", text)):

        out.append("Description says the victims are female, but a male victim is recorded.")

    m = re.search(r"\b(one|two|three|four|five|six|\d+)\s+(teenage\s+|young\s+)?(victims|teenagers|minors|children)\b", text)

    if m and n:

        claimed = NUMWORDS.get(m.group(1)) or int(m.group(1))

        if claimed != n:

            out.append(f"Description mentions {claimed} victims but {n} are recorded.")

    for v in victims:

        if v["age"] is not None and not 0 <= v["age"] <= 110:

            out.append(f"Implausible age for {v['name']}.")

    return out





def _sig(payload: str) -> str:

    return hmac.new(secret_key().encode(), payload.encode(), hashlib.sha256).hexdigest()





def load_calibration() -> Optional[Dict[str, Any]]:

    try:

        raw = json.loads(Config.MODEL.read_text())

        body = json.dumps(raw["model"], sort_keys=True)

        return raw["model"] if hmac.compare_digest(raw["sig"], _sig(body)) else None

    except (OSError, KeyError, ValueError):

        return None





def train_calibration(df: pd.DataFrame) -> Dict[str, Any]:

    if not {"log_odds", "label"} <= set(df.columns):

        raise ValueError("CSV needs columns: log_odds, label")

    df = df[["log_odds", "label"]].dropna().astype(float)

    if len(df) < 30 or df["label"].nunique() < 2 or not set(df["label"]) <= {0.0, 1.0}:

        raise ValueError("Need at least 30 rows with labels 0 and 1 (both present).")

    xs, ys = df["log_odds"].tolist(), df["label"].tolist()

    a, b = 1.0, 0.0

    for _ in range(3000):

        ga = gb = 0.0

        for x, y in zip(xs, ys):

            p = 1 / (1 + math.exp(-max(-30, min(30, a * x + b))))

            ga += (p - y) * x

            gb += p - y

        a -= 0.05 * ga / len(xs)

        b -= 0.05 * gb / len(xs)

    brier = sum((1 / (1 + math.exp(-(a * x + b))) - y) ** 2 for x, y in zip(xs, ys)) / len(xs)

    model = {"a": a, "b": b, "n": len(xs), "brier_in_sample": brier, "trained": now_iso()}

    Config.MODEL.write_text(json.dumps({"model": model, "sig": _sig(json.dumps(model, sort_keys=True))}))

    return model





def calibrated(post: float, model: Optional[Dict[str, Any]]) -> Optional[float]:

    if not model:

        return None

    p = min(1 - 1e-9, max(1e-9, post))

    return 1 / (1 + math.exp(-(model["a"] * math.log(p / (1 - p)) + model["b"])))





