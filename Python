@contextmanager

def db():

    conn = sqlite3.connect(str(Config.DB), timeout=15)

    conn.row_factory = sqlite3.Row

    conn.execute("PRAGMA foreign_keys = ON")

    try:

        yield conn

        conn.commit()

    except Exception:

        conn.rollback()

        raise

    finally:

        conn.close()





def init_db() -> None:

    ensure_dirs()

    with db() as c:

        c.execute("PRAGMA journal_mode = WAL")

        c.executescript(SCHEMA)

        if c.execute("SELECT COUNT(*) n FROM users").fetchone()["n"]:

            return

        user = os.environ.get("SICCA_ADMIN_USER", "admin")

        pw = os.environ.get("SICCA_ADMIN_PASS") or secrets.token_urlsafe(14)

        c.execute("INSERT INTO users(username,password,role) VALUES(?,?,?)",

                  (user, generate_password_hash(pw), "admin"))

        print(f"\n*** SICCA initial admin login ***\n user: {user}\n pass: {pw}\n", file=sys.stderr)





