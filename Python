def parse_iso_date(raw: str, label: str) -> str:
    try:
        d = datetime.strptime(raw, "%Y-%m-%d").date()
    except ValueError:
        raise FormError(f"{label} must be written YYYY-MM-DD.")
    today = datetime.now(timezone.utc).date()
    if d.year < 1900 or d > today + timedelta(days=1):
        raise FormError(f"{label} must be between 1900 and today.")
    return d.isoformat()


def parse_int(raw: Any, label: str, lo: int, hi: int, default: Optional[int] = None) -> int:
    if raw is None or str(raw).strip() == "":
        if default is not None:
            return default
        raise FormError(f"{label} is required.")
    try:
        n = int(str(raw).strip())
    except ValueError:
        raise FormError(f"{label} must be a whole number.")
    if not lo <= n <= hi:
        raise FormError(f"{label} must be between {lo} and {hi}.")
    return n


def parse_float(raw: Any, label: str, lo: float, hi: float, default: Optional[float] = None) -> float:
    if raw is None or str(raw).strip() == "":
        if default is not None:
            return default
        raise FormError(f"{label} is required.")
    try:
        x = float(str(raw).strip())
    except ValueError:
        raise FormError(f"{label} must be a number.")
    if not isfinite(x) or not lo <= x <= hi:
        raise FormError(f"{label} must be between {lo} and {hi}.")
    return x


def parse_choice(raw: Any, label: str, choices: Tuple[str, ...], default: str) -> str:
    value = clean_text(raw, 40).lower() or default
    if value not in choices:
        raise FormError(f"{label} must be one of: {', '.join(choices)}.")
    return value


def coerce_int(value: Any, default: int, lo: int, hi: int) -> int:
    try:
        n = int(float(value))
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


def coerce_float(value: Any, default: float, lo: float, hi: float) -> float:
    try:
        x = float(value)
    except (TypeError, ValueError):
        return default
    if not isfinite(x):
        return default
    return max(lo, min(hi, x))


def build_case_record(form: Mapping[str, Any], case_id: str, username: str) -> Dict[str, Any]:
    name = clean_text(form.get("case_name"), 200)
    if not name:
        raise FormError("Case name is required.")
    now = now_iso()
    active_since = parse_iso_date(clean_text(form.get("active_since"), 10) or now[:10], "Active since")
    return {
        "case_id": case_id,
        "case_name": name,
        "location": clean_text(form.get("location"), 200),
        "year": parse_int(form.get("year"), "Year", 1900, 2100, default=datetime.now().year),
        "type": parse_choice(form.get("type"), "Type", CASE_TYPES, "unknown"),
        "status": parse_choice(form.get("status"), "Status", STATUSES, "open"),
        "confidence": parse_float(form.get("confidence"), "Confidence", 0.0, 1.0, default=0.5),
        "suspects_count": parse_int(form.get("suspects_count"), "Suspects", 0, 1000, default=0),
        "evidence_count": parse_int(form.get("evidence_count"), "Evidence items", 0, 10000, default=0),
        "evidence_strength": parse_choice(form.get("evidence_strength"), "Evidence strength", EVIDENCE_STRENGTHS, "moderate"),
        "description": clean_text(form.get("description"), 5000, multiline=True),
        "priority": parse_choice(form.get("priority"), "Priority", PRIORITIES, "medium"),
        "assigned_to": clean_text(form.get("assigned_to"), 100),
        "tags": clean_text(form.get("tags"), 500),
        "attached_file": None,
        "file_path": None,
        "created_by": username,
        "active_since": active_since,
        "created": now,
        "modified": now,
    }


def sniff_matches(ext: str, head: bytes) -> bool:
    if ext == ".pdf":
        return head.startswith(b"%PDF-")
    if ext in (".jpg", ".jpeg"):
        return head.startswith(b"\xff\xd8\xff")
    if ext == ".png":
        return head.startswith(b"\x89PNG\r\n\x1a\n")
    if ext == ".docx":
        return head.startswith(b"PK\x03\x04")
    if ext == ".doc":
        return head.startswith(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1")
    if ext == ".txt":
        return b"\x00" not in head
    return False


def _docx_ok(stream) -> bool:
    try:
        with zipfile.ZipFile(stream) as z:
            names = set(z.namelist())
        return ("[Content_Types].xml" in names and any(n.startswith("word/") for n in names))
    except (zipfile.BadZipFile, OSError, ValueError):
        return False
    finally:
        stream.seek(0)


def prepare_upload(file, case_id: str):
    if not file or not file.filename:
        return None
    ext = Path(file.filename).suffix.lower()
    if ext not in Config.ALLOWED_UPLOAD_EXTENSIONS:
        raise FormError(f"File type '{ext or 'unknown'}' is not allowed.")
    head = file.stream.read(16)
    file.stream.seek(0)
    if not sniff_matches(ext, head) or (ext == ".docx" and not _docx_ok(file.stream)):
        raise FormError("File contents do not match its extension.")
    display = secure_filename(file.filename) or f"upload{ext}"
    stored = f"{secure_filename(case_id)}__{uuid.uuid4().hex[:8]}__{display}"
    return file, stored, display


