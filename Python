CATEGORICAL = ["type", "status", "priority"]
# "location" is deliberately excluded (proxy for demographics).
# The Bayesian posterior is deliberately excluded too: feeding it in made the
# ML score depend on the Bayesian score, so blending them double-counted it.
NUMERIC = ["year", "suspects_count", "evidence_count"]
TARGET = "label"
FEATURE_SPEC = {"categorical": CATEGORICAL, "numeric": NUMERIC}


def _make_ohe() -> OneHotEncoder:
    try:
        return OneHotEncoder(handle_unknown="ignore", sparse_output=False)
    except TypeError:  # scikit-learn < 1.2
        return OneHotEncoder(handle_unknown="ignore", sparse=False)


def build_pipeline() -> Pipeline:
    pre = ColumnTransformer(
        transformers=[("cat", _make_ohe(), CATEGORICAL),
                      ("num", StandardScaler(), NUMERIC)],
        remainder="drop",
    )
    return Pipeline([("pre", pre),
                     ("clf", LogisticRegression(max_iter=2000,
                                                random_state=42))])


def _sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _nan_to_none(x: float) -> Optional[float]:
    return None if (x is None or not isfinite(x)) else float(x)


class MLModel:
    def __init__(self, path: Path, hash_path: Path):
        self.path = path
        self.hash_path = hash_path
        self._pipe: Optional[Pipeline] = None
        self._meta: Dict[str, Any] = {}
        self._mtime: float = 0.0
        self._lock = threading.Lock()

    def exists(self) -> bool:
        return self.path.exists()

    def load(self) -> Pipeline:
        """Loads (and reloads if another worker retrained) after an
        integrity check. joblib files are pickles: only load files that this
        app wrote."""
        with self._lock:
            if not self.exists():
                raise FileNotFoundError("Model not trained yet.")
            mtime = self.path.stat().st_mtime
            if self._pipe is not None and mtime == self._mtime:
                return self._pipe
            expected = (self.hash_path.read_text().strip()
                        if self.hash_path.exists() else "")
            if expected != _sha256(self.path):
                raise RuntimeError(
                    "Model file failed its integrity check; retrain it.")
            artifact = joblib.load(self.path)
            meta = artifact.get("meta", {})
            if meta.get("features") != FEATURE_SPEC:
                raise RuntimeError(
                    "Model was trained with a different feature set; retrain.")
            self._pipe, self._meta, self._mtime = artifact["pipeline"], meta, mtime
            return self._pipe

    @property
    def meta(self) -> Dict[str, Any]:
        try:
            self.load()
        except Exception:
            return {}
        return self._meta

    def train(self, df: pd.DataFrame) -> Dict[str, Any]:
        missing = [c for c in CATEGORICAL + NUMERIC + [TARGET]
                   if c not in df.columns]
        if missing:
            raise ValueError(f"Missing required columns: {missing}")

        df = df[CATEGORICAL + NUMERIC + [TARGET]].copy()
        for c in CATEGORICAL:
            df[c] = df[c].astype(str).str.strip().str.lower()
        for c in NUMERIC + [TARGET]:
            df[c] = pd.to_numeric(df[c], errors="coerce")
        df = df.dropna()
        df = df[df[TARGET].isin([0, 1])]
        df[TARGET] = df[TARGET].astype(int)

        if len(df) < Config.MIN_TRAIN_ROWS:
            raise ValueError(
                f"Only {len(df)} usable rows; at least "
                f"{Config.MIN_TRAIN_ROWS} are required for meaningful metrics.")
        counts = df[TARGET].value_counts()
        if len(counts) < 2 or counts.min() < Config.MIN_PER_CLASS:
            raise ValueError(
                f"Each class (0 and 1) needs at least {Config.MIN_PER_CLASS} "
                f"rows; got {counts.to_dict()}.")

        y = df[TARGET]
        X = df[CATEGORICAL + NUMERIC]
        X_tr, X_te, y_tr, y_te = train_test_split(
            X, y, test_size=0.25, random_state=42, stratify=y)

        pipe = build_pipeline()
        pipe.fit(X_tr, y_tr)
        prob = pipe.predict_proba(X_te)[:, 1]
        pred = (prob >= 0.5).astype(int)

        trained_at = now_iso()
        metrics = {
            "roc_auc": (_nan_to_none(float(roc_auc_score(y_te, prob)))
                        if y_te.nunique() > 1 else None),
            "accuracy": float((pred == y_te).mean()),
            "report": classification_report(y_te, pred, output_dict=True,
                                            zero_division=0),
            "training_samples": int(len(X_tr)),
            "test_samples": int(len(X_te)),
            "model_version": Config.MODEL_VERSION,
            "trained_at": trained_at,
        }
        artifact = {"pipeline": pipe,
                    "meta": {"version": Config.MODEL_VERSION,
                             "trained_at": trained_at,
                             "features": FEATURE_SPEC,
                             "metrics": metrics}}
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        joblib.dump(artifact, tmp)
        digest = _sha256(tmp)
        os.replace(tmp, self.path)
        self.hash_path.write_text(digest)
        with self._lock:
            self._pipe, self._meta = pipe, artifact["meta"]
            self._mtime = self.path.stat().st_mtime
        return metrics

    def predict_one(self, case: Mapping[str, Any]
                    ) -> Tuple[Optional[float], str]:
        if not self.exists():
            return None, "ML model is not trained."
        try:
            pipe = self.load()
            X = pd.DataFrame([self._case_to_row(case)])[CATEGORICAL + NUMERIC]
            return float(pipe.predict_proba(X)[0, 1]), ""
        except Exception as exc:
            LOG.exception("ML prediction failed")
            return None, f"ML unavailable: {exc}"

    @staticmethod
    def _case_to_row(case: Mapping[str, Any]) -> Dict[str, Any]:
        yr = datetime.now().year
        return {
            "type": str(case.get("type", "unknown")).lower(),
            "status": str(case.get("status", "open")).lower(),
            "priority": str(case.get("priority", "medium")).lower(),
            "year": coerce_int(case.get("year", yr), yr, 1900, 2100),
            "suspects_count": coerce_int(case.get("suspects_count", 0),
                                         0, 0, 1000),
            "evidence_count": coerce_int(case.get("evidence_count", 0),
                                         0, 0, 10000),
        }


# =============================================================================
# CROSS-BORDER HEURISTICS (rule-based; labelled honestly)
# =============================================================================

CRIME_CATEGORY = {
    "homicide": "violent_crime", "assault": "violent_crime",
    "robbery": "violent_crime", "fraud": "financial_crime",
    "theft": "property_crime", "burglary": "property_crime",
    "arson": "property_crime", "vandalism": "property_crime",
}


class CrossBorderHeuristics:
    @staticmethod
    def risk(case: Mapping[str, Any]) -> Dict[str, Any]:
        category = CRIME_CATEGORY.get(str(case.get("type", "")).lower(),
                                      "other_crime")
        crime_risk = {
            "violent_crime": 0.8, "sexual_violence": 0.9, "terrorism": 1.0,
            "organized_crime": 0.7, "financial_crime": 0.4,
            "property_crime": 0.3,
        }.get(category, 0.5)
        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        score = (0.6 * crime_risk + 0.2 * min(1.0, ev / 10.0)
                 + 0.2 * min(1.0, su / 5.0))
        return {
            "risk_score": round(score, 3),
            "risk_level": risk_level(score),
            "crime_category": category,
            "method": "transparent_heuristic",
            "factors": ["crime_category", "evidence_count", "suspects_count"],
        }


# =============================================================================
# HYBRID ENGINE
# =============================================================================

class HybridEngine:
    W_BAYES = 0.6
    W_ML = 0.4

    def __init__(self, ml: MLModel):
        self.ml = ml

    @staticmethod
    def _ml_certainty(p: float) -> str:
        d = abs(p - 0.5) * 2  # 0 = coin flip, 1 = fully certain either way
        return "high" if d > 0.6 else "medium" if d > 0.3 else "low"

    def analyze(self, case: Mapping[str, Any]) -> Dict[str, Any]:
        t0 = time.perf_counter()
        bayes = bayesian_score(case, datetime.now().year)
        ml_prob, ml_err = self.ml.predict_one(case)
        version = self.ml.meta.get("version", Config.MODEL_VERSION)

        if ml_prob is None:
            final = bayes["adjusted_posterior"]
            weights = {"bayesian": 1.0, "ml": 0.0}
            ml_block = {"probability": None, "confidence": "unavailable",
                        "model_available": False, "error": ml_err,
                        "model_version": version}
        else:
            weights = {"bayesian": self.W_BAYES, "ml": self.W_ML}
            final = (weights["bayesian"] * bayes["adjusted_posterior"]
                     + weights["ml"] * ml_prob)
            ml_block = {"probability": ml_prob,
                        "confidence": self._ml_certainty(ml_prob),
                        "model_available": True, "error": "",
                        "model_version": version}

        agreement = (ml_prob is not None
                     and abs(bayes["adjusted_posterior"] - ml_prob) <= 0.2)
        b = bayes["confidence"]
        if ml_prob is None:
            overall = "medium" if b > 0.5 else "low"
        elif b > 0.7 and ml_block["confidence"] == "high" and agreement:
            overall = "high"
        else:
            overall = "medium" if b > 0.5 else "low"

        hybrid = {
            "final_risk_score": float(final),
            "risk_level": risk_level(final),
            "weight_bayesian": weights["bayesian"],
            "weight_ml": weights["ml"],
            "agreement": agreement,
            "confidence": overall,
            "calculation": (f"{weights['bayesian']:.0%} Bayesian + "
                            f"{weights['ml']:.0%} ML"),
        }
        return {
            "bayesian": bayes,
            "machine_learning": ml_block,
            "hybrid_analysis": hybrid,
            "cross_border": CrossBorderHeuristics.risk(case),
            "insights": self._insights(hybrid, case, ml_block),
            "metadata": {
                "analysis_id": secrets.token_hex(8),
                "timestamp": now_iso(),
                "analysis_time": round(time.perf_counter() - t0, 4),
                "model_version": version,
            },
        }

    @staticmethod
    def _insights(hybrid: Mapping[str, Any], case: Mapping[str, Any],
                  ml: Mapping[str, Any]) -> List[str]:
        out: List[str] = []
        risk = hybrid["risk_level"]
        if risk == "high":
            out.append("High risk score -- prioritise review.")
            out.append("Consider allocating additional resources.")
        elif risk == "medium":
            out.append("Medium risk score -- standard protocol.")

        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        if ev < 3:
            out.append("Limited evidence -- recommend evidence collection.")
        elif ev > 10:
            out.append("Substantial evidence -- focus on analysis.")

        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        if su == 0:
            out.append("No suspects identified -- recommend suspect profiling.")
        elif su > 3:
            out.append("Multiple suspects -- consider connection analysis.")

        if ml.get("model_available"):
            out.append("Models agree." if hybrid["agreement"]
                       else "Models diverge -- recommend manual review.")
        else:
            out.append(f"{ml.get('error') or 'ML unavailable'}; "
                       "score is Bayesian-only.")

        yr = coerce_int(case.get("year", datetime.now().year),
                        datetime.now().year, 1900, 2100)
        if datetime.now().year - yr > 5:
            out.append("Case is aged -- consider evidence degradation.")

        out.append("Scores are uncalibrated decision support, not evidence; "
                   "a human must make the decision.")
        return out


