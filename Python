# HYBRID ANALYTICS  (FIX #2: high risk reachable; weights renormalise.)
# =============================================================================

class HybridEngine:
    def __init__(self, ml: MLModel):
        self.ml = ml

    def analyze(self, case: Dict[str, Any]) -> Dict[str, Any]:
        t0 = time.perf_counter()
        current_year = datetime.now().year

        bayes = bayesian_score(case, current_year)
        ml_prob, ml_err = self.ml.predict_one(case, bayes)

        if ml_prob is None:
            # FIX #2: when ML is unavailable, do not blend in a constant
            # 0.5 (which capped the score at ~0.54 and made "high" unreachable).
            final = bayes["adjusted_posterior"]
            weights = {"bayesian": 1.0, "ml": 0.0}
            ml_block = {
                "probability": None,
                "confidence": "unavailable",
                "model_available": False,
                "error": ml_err,
                "model_version": self.ml.meta.get(
                    "version", Config.MODEL_VERSION),
            }
        else:
            weights = {"bayesian": 0.6, "ml": 0.4}
            final = (weights["bayesian"] * bayes["adjusted_posterior"]
                     + weights["ml"] * ml_prob)
            ml_block = {
                "probability": ml_prob,
                "confidence": ("high" if ml_prob > 0.8
                               else "medium" if ml_prob > 0.6 else "low"),
                "model_available": True,
                "error": "",
                "model_version": self.ml.meta.get(
                    "version", Config.MODEL_VERSION),
            }

        agreement = (ml_prob is not None
                     and abs(bayes["adjusted_posterior"] - ml_prob) <= 0.2)

        overall_conf = (
            "high" if bayes["confidence"] > 0.7 and ml_block["confidence"] == "high"
            else "medium" if bayes["confidence"] > 0.5
            else "low"
        )
        risk = "high" if final > 0.7 else "medium" if final > 0.4 else "low"
        elapsed = time.perf_counter() - t0

        hybrid = {
            "final_risk_score": float(final),
            "risk_level": risk,
            "weight_bayesian": weights["bayesian"],
            "weight_ml": weights["ml"],
            "agreement": agreement,
            "confidence": overall_conf,
            "calculation": (f"{weights['bayesian']:.0%} Bayesian + "
                            f"{weights['ml']:.0%} ML"),
        }
        return {
            "bayesian": bayes,
            "machine_learning": ml_block,
            "hybrid_analysis": hybrid,
            "insights": self._insights(hybrid, case, ml_block),
            "metadata": {
                "analysis_id": secrets.token_hex(8),
                "timestamp": datetime.utcnow().isoformat(),
                # FIX #9: measured, not hardcoded.
                "analysis_time": round(elapsed, 4),
                "model_version": ml_block["model_version"],
            },
        }

    @staticmethod
    def _insights(hybrid: Dict[str, Any], case: Dict[str, Any],
                  ml: Dict[str, Any]) -> List[str]:
        out: List[str] = []
        risk = hybrid["risk_level"]
        if risk == "high":
            out.append("High risk -- recommend immediate investigation.")
            out.append("Consider allocating additional resources.")
        elif risk == "medium":
            out.append("Medium risk -- standard investigation protocol.")

        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        if ev < 3:
            out.append("Limited evidence -- recommend evidence collection.")
        elif ev > 10:
            out.append("Substantial evidence -- focus on analysis.")

        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        if su == 0:
            out.append("No suspects identified -- recommend suspect profiling.")
        elif su > 3:
            out.append("Multiple suspects -- consider connection analysis.")

        if ml.get("model_available"):
            if hybrid["agreement"]:
                out.append("Strong model agreement -- high confidence.")
            else:
                out.append("Model divergence -- recommend manual review.")
        else:
            out.append(f"ML unavailable ({ml.get('error', 'unknown')}); "
                       "score is Bayesian-only.")

        year = coerce_int(case.get("year", datetime.now().year),
                          datetime.now().year, 1900, 2100)
        if datetime.now().year - year > 5:
            out.append("Case aged -- consider evidence degradation.")

        out.append("Case ready for detailed forensic analysis.")
        return out


