    def add_evidence():

        f = request.form

        a, b = clean(f.get("a"), 50), clean(f.get("b"), 50)

        try:

            cat = f.get("category")

            if cat not in CATEGORIES or f.get("status") not in STATUS_W or not clean(f.get("description"), 300):

                raise ValueError

            rel = float(f.get("reliability") or 0.7)

            lr = float(f.get("lr")) if clean(f.get("lr")) else CATEGORIES[cat][0]

            if not (0 <= rel <= 1 and 0.01 <= lr <= 1000) or not math.isfinite(lr + rel):

                raise ValueError

        except (TypeError, ValueError):

            flash("Invalid evidence: check category, status, reliability (0-1) and LR (0.01-1000).", "error")

            return back(a, b, f.get("prior"))

        x, y = sorted((a, b))

        with db() as c:

            get_case(c, x), get_case(c, y)

            c.execute("INSERT INTO link_evidence(case_a,case_b,category,description,source,status,reliability,lr,grp,created_by,created) VALUES(?,?,?,?,?,?,?,?,?,?,?)",

                      (x, y, cat, clean(f.get("description"), 300), clean(f.get("source"), 300),

                       f["status"], rel, lr, clean(f.get("grp"), 40).lower(),

                       current_user.username, now_iso()))

