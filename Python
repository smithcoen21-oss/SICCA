        if request.method == "GET":
            return render_create()
        saved_path: Optional[Path] = None
        try:
            case_id = clean_text(request.form.get("case_id"), 50)
            ok, msg = validate_case_id(case_id)
            if not ok:
                raise FormError(msg)
            record = build_case_record(request.form, case_id,
                                       current_user.username)
            upload = prepare_upload(request.files.get("case_file"), case_id)
        except FormError as exc:
            flash(str(exc), "error")
            return render_create(400)
        with db() as conn:
            if conn.execute("SELECT 1 FROM cases WHERE case_id = ?",
                            (case_id,)).fetchone():
                flash("Case ID already exists", "error")
                return render_create(409)
        try:
            if upload:
                file, stored, display = upload
                saved_path = Config.UPLOADS_DIR / stored
                file.save(saved_path)
                record["attached_file"] = display
                record["file_path"] = stored
            with db() as conn:
                conn.execute(
                    """INSERT INTO cases (case_id, case_name, location, year,
                    type, status, confidence, suspects_count, evidence_count,
                    evidence_strength, description, priority, assigned_to,
                    tags, attached_file, file_path, created_by, active_since,
                    reopened_count, created, modified)
                    VALUES (:case_id, :case_name, :location, :year, :type,
                    :status, :confidence, :suspects_count, :evidence_count,
                    :evidence_strength, :description, :priority, :assigned_to,
                    :tags, :attached_file, :file_path, :created_by,
                    :active_since, 0, :created, :modified)""", record)
                audit(current_user.username, "create_case", case_id,
                      conn=conn)
        except sqlite3.IntegrityError:
            _discard(saved_path)
            flash("Case ID already exists", "error")
            return render_create(409)
        except Exception:
            _discard(saved_path)
            ref = secrets.token_hex(4)
            LOG.exception("Failed to save case %s (ref %s)", case_id, ref)
            flash(f"Could not save the case. Reference: {ref}", "error")
