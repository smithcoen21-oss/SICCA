                    :description, :priority, :assigned_to, :tags,
                    :attached_file, :file_path, :created_by, :created,
                    :modified)""", record)
                audit(current_user.username, "create_case", case_id,
                      conn=conn)
        except sqlite3.IntegrityError:
            _discard(saved_path)
            flash("Case ID already exists", "error")
            return render_create(409)
        except Exception:
            _discard(saved_path)
            ref = secrets.token_hex(4)
            LOG.exception("Failed to save case %s (ref %s)", case_id, ref)
            flash(f"Could not save the case. Reference: {ref}", "error")
            return render_create(500)
        flash(f"Case {case_id} created.", "success")
        return redirect(url_for("view_case", case_id=case_id))

    # -------------------------------------------------------------- view
    @app.route("/case/<case_id>")
    @login_required
    def view_case(case_id: str):
        return render_template("view_case.html",
                               case=dict(fetch_case(case_id)))

    @app.route("/case/<case_id>/file")
    @login_required
    def download_file(case_id: str):
        row = fetch_case(case_id)
        if not row["file_path"]:
            abort(404)
        root = Config.UPLOADS_DIR.resolve()
        target = (root / row["file_path"]).resolve()
        if root not in target.parents or not target.is_file():
            abort(404)
        audit(current_user.username, "download_file", case_id)
        return send_file(target, as_attachment=True,
                         download_name=row["attached_file"] or target.name)

