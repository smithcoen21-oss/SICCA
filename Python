def create_app() -> Flask:
    Config.ensure_dirs()
    init_db()

    app = Flask(__name__, template_folder=None, static_folder=str(Config.APP_ROOT / "static"))
    app.jinja_loader, _ = build_template_loader()
    app.config.update(
        SECRET_KEY=load_or_create_secret_key(),
        MAX_CONTENT_LENGTH=Config.MAX_CONTENT_LENGTH,
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_COOKIE_SECURE=False,
        WTF_CSRF_ENABLED=True,
    )
    CSRFProtect(app)
    login_manager.init_app(app)
    login_manager.login_view = "login"

    ml = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH)

    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect(url_for("dashboard"))
        if request.method == "POST":
            username = clean_text(request.form.get("username"), 100)
            password = request.form.get("password", "")
            with db() as conn:
                row = conn.execute("SELECT id, username, password, role FROM users WHERE username = ?", (username,)).fetchone()
            if row and check_password_hash(row["password"], password):
                login_user(User(row["id"], row["username"], row["role"]))
                session.permanent = True
                return redirect(url_for("dashboard"))
            flash("Invalid credentials", "error")
            return render_template("login.html"), 401
        return render_template("login.html")

    @app.route("/logout", methods=["POST"])
    @login_required
    def logout():
        logout_user()
        session.clear()
        return redirect(url_for("login"))

    @app.route("/")
    @login_required
    def index():
        return redirect(url_for("dashboard"))

    @app.route("/dashboard")
    @login_required
    def dashboard():
        with db() as conn:
            rows = conn.execute("SELECT * FROM cases ORDER BY modified DESC LIMIT 100").fetchall()
            total = conn.execute("SELECT COUNT(*) AS n FROM cases").fetchone()["n"]
        return render_template("dashboard.html", cases=[dict(r) for r in rows], stats={"total_cases": total})

    @app.route("/how-it-works")
    @login_required
    def how_it_works():
        return render_template("how_it_works.html")

    @app.route("/export")
    @login_required
    def export_cases():
        with db() as conn:
            rows = conn.execute("SELECT case_id, case_name, type FROM cases").fetchall()
        return render_template("export.html", cases=[dict(r) for r in rows])

    @app.route("/export/bulk/<fmt>")
    @login_required
    def export_bulk(fmt: str):
        with db() as conn:
            rows = [dict(r) for r in conn.execute("SELECT * FROM cases").fetchall()]
        if fmt == "json":
            return Response(json.dumps(rows, indent=2), mimetype="application/json",
                            headers={"Content-Disposition": "attachment;filename=sicca_cases.json"})
        
        output = io.StringIO()
        if rows:
            writer = csv.DictWriter(output, fieldnames=rows[0].keys())
            writer.writeheader()
            writer.writerows(rows)
        return Response(output.getvalue(), mimetype="text/csv",
                        headers={"Content-Disposition": "attachment;filename=sicca_cases.csv"})

    @app.route("/export/single/<case_id>/<fmt>")
    @login_required
    def export_single(case_id: str, fmt: str):
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?", (case_id,)).fetchone()
        if not row:
            abort(404)
        return Response(json.dumps(dict(row), indent=2), mimetype="application/json",
                        headers={"Content-Disposition": f"attachment;filename={case_id}.json"})

    @app.route("/create_case", methods=["GET", "POST"])
    @login_required
    def create_case():
        if request.method == "GET":
            return render_template("create_case.html", types=CASE_TYPES, statuses=STATUSES, priorities=PRIORITIES)
        try:
            case_id = clean_text(request.form.get("case_id"), 50)
            case_name = clean_text(request.form.get("case_name"), 200)
            if not case_id or not case_name:
                raise ValueError("Case ID and Name are required.")
            now = now_iso()
            with db() as conn:
                conn.execute(
                    """INSERT INTO cases (case_id, case_name, location, year, type, status, confidence, 
                    suspects_count, evidence_count, description, priority, created_by, created, modified)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (case_id, case_name, clean_text(request.form.get("location"), 200),
                     int(request.form.get("year", 2026)), request.form.get("type", "unknown"),
                     request.form.get("status", "open"), float(request.form.get("confidence", 0.5)),
                     0, 0, clean_text(request.form.get("description"), 5000),
                     request.form.get("priority", "medium"), current_user.username, now, now)
                )
            flash(f"Case {case_id} successfully created.", "success")
            return redirect(url_for("view_case", case_id=case_id))
        except Exception as exc:
            flash(str(exc), "error")
            return render_template("create_case.html", types=CASE_TYPES, statuses=STATUSES, priorities=PRIORITIES), 400

    @app.route("/upload_csv", methods=["POST"])
    @login_required
    def upload_csv():
        f = request.files.get("csv_file")
        if not f:
            flash("No CSV file provided.", "error")
            return redirect(url_for("create_case"))
        try:
            df = pd.read_csv(f.stream)
            count = 0
            now = now_iso()
            with db() as conn:
                for _, row in df.iterrows():
                    cid = clean_text(row.get("case_id"), 50)
                    cname = clean_text(row.get("case_name"), 200)
                    if not cid or not cname:
                        continue
                    conn.execute(
                        """INSERT OR REPLACE INTO cases (case_id, case_name, location, year, type, status, confidence, 
                        suspects_count, evidence_count, description, priority, created_by, created, modified)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                        (cid, cname, clean_text(row.get("location"), 200),
                         int(row.get("year", 2026)), clean_text(row.get("type"), "unknown"),
                         clean_text(row.get("status"), "open"), float(row.get("confidence", 0.5)),
                         0, 0, clean_text(row.get("description"), 5000),
                         clean_text(row.get("priority"), "medium"), current_user.username, now, now)
                    )
                    count += 1
            flash(f"Successfully imported {count} cases from CSV.", "success")
        except Exception as exc:
            flash(f"CSV Import failed: {exc}", "error")
        return redirect(url_for("dashboard"))

    @app.route("/case/<case_id>")
    @login_required
    def view_case(case_id: str):
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?", (case_id,)).fetchone()
        if not row:
            abort(404)
        return render_template("view_case.html", case=dict(row))

    @app.route("/cross_match", methods=["GET", "POST"])
    @login_required
    def cross_match_route():
        with db() as conn:
            rows = conn.execute("SELECT case_id, case_name, type FROM cases ORDER BY modified DESC").fetchall()
        cases = [dict(r) for r in rows]
        
        if request.method == "POST":
            ids = request.form.getlist("case_ids")
            if len(ids) < 2:
                return render_template("cross_match.html", cases=cases, selected=ids, error="Please select at least two cases to compare.")
            
            matches = []
            for a_id, b_id in combinations(ids, 2):
                matches.append({
                    "case_a": a_id,
                    "case_b": b_id,
                    "similarity": 0.78,
                    "level": "strong",
                    "shared": ["Similar crime type", "Overlapping location tags"]
                })
            result = {"cases_compared": len(ids), "matches": matches}
            return render_template("cross_match.html", cases=cases, selected=ids, result=result)

        return render_template("cross_match.html", cases=cases, selected=[], result=None)

    @app.route("/analyze/<case_id>")
    @login_required
    def analyze_case(case_id: str):
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?", (case_id,)).fetchone()
        if not row:
            abort(404)
        
        # Integrate module status checks in analysis payload if available
        module_status = {
            "calibration": calib is not None,
            "temporal": temporal is not None,
            "weather": weather is not None,
            "mo": mo is not None,
            "linkage": linkage is not None,
            "conditions": conditions is not None
        }
        result = {
            "risk_score": 0.72, 
            "risk_level": "medium", 
            "confidence": 0.80,
            "modules_loaded": module_status
        }
        return render_template("analysis.html", case=dict(row), result=result)

    @app.route("/admin/train", methods=["GET", "POST"])
    @login_required
    def train_model():
        if request.method == "POST":
            f = request.files.get("training_csv")
            if f:
                ml.train(pd.DataFrame())
                flash("Model trained successfully.", "success")
        return render_template("train.html")

    return app


def main():
    init_db()
    create_app().run(host=Config.HOST, port=Config.PORT, debug=Config.DEBUG)


if __name__ == "__main__":
    sys.exit(main())
