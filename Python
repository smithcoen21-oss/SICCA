def validated_case(f) -> Dict[str, Any]:
    cid, name = clean(f.get("case_id"), 50), clean(f.get("case_name"), 200)
    if not cid or not name:
        raise ValueError("Case ID and name are required.")
    if not re.fullmatch(r"[\w\-. ]+", cid):
        raise ValueError("Case ID may contain letters, digits, space, - _ . only.")
    try:
        year = int(float(f.get("year") or datetime.now().year))
    except (TypeError, ValueError):
        raise ValueError("Year must be a number.")
    if not 1800 <= year <= 2100:
        raise ValueError("Year out of range.")
    return {"case_id": cid, "case_name": name, "location": clean(f.get("location"), 200), "year": year,
            "type": pick(f.get("type"), CASE_TYPES, "unknown"),
            "status": pick(f.get("status"), STATUSES, "open"),
            "priority": pick(f.get("priority"), PRIORITIES, "medium"),
            "description": clean(f.get("description"), 5000)}

def insert_case(conn, d: Dict[str, Any], replace: bool = False) -> bool:
    t = now_iso()
    cur = conn.execute(
        f"INSERT OR {'REPLACE' if replace else 'IGNORE'} INTO cases(case_id,case_name,location,year,type,status,priority,description,created_by,created,modified) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
        (d["case_id"], d["case_name"], d["location"], d["year"], d["type"], d["status"],
         d["priority"], d["description"], current_user.username, t, t))
    return cur.rowcount > 0

