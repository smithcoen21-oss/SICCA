class User(UserMixin):
    def __init__(self, uid: int, username: str, role: str):
        self.id = str(uid)
        self.username = username
        self.role = role

    def is_admin(self) -> bool:
        return self.role == "admin"


login_manager = LoginManager()


@login_manager.user_loader
def load_user(uid: str) -> Optional[User]:
    with db() as conn:
        row = conn.execute("SELECT id, username, role FROM users WHERE id = ?", (uid,)).fetchone()
    return User(row["id"], row["username"], row["role"]) if row else None


