    def _observed_variables_for(case_id: str) -> dict:
        """Assemble the flat dict of observed variables for the MO module."""
        observed: dict = {}
        if temporal is not None:
            try:
                with db() as conn:
                    windows = [dict(w) for w in conn.execute(
                        "SELECT * FROM time_window")]
                    case_row = conn.execute(
                        "SELECT * FROM cases WHERE case_id = ?",
                        (case_id,)).fetchone()
                if case_row:
                    prof = temporal.temporal_profile(dict(case_row), windows)
                    if prof.get("ok"):
                        for w in windows:
                            wid = w["window_id"]
                            observed[wid] = 1 if any(
                                m["window_id"] == wid
                                for m in prof.get("matched", [])
                            ) else 0
            except Exception:
                LOG.exception("temporal variables failed for %s", case_id)
        with db() as conn:
            row = conn.execute(
                "SELECT * FROM case_weather WHERE case_id = ? "
                "ORDER BY obs_date LIMIT 1", (case_id,)).fetchone() \
                if _table_exists(conn, "case_weather") else None
        if row:
            for var in ("precipitation_mm", "temp_max_c", "temp_min_c",
                        "wind_max_kmh", "humidity_pct", "snow_depth_cm"):
                if row[var] is not None:
                    observed[var] = float(row[var])
        return observed

