    @classmethod
    def ensure_dirs(cls) -> None:
        for d in (cls.BASE_DIR, cls.LOGS_DIR, cls.UPLOADS_DIR, cls.MODELS_DIR):
            d.mkdir(parents=True, exist_ok=True)


def load_or_create_secret_key() -> str:
    env = os.environ.get("SICCA_SECRET_KEY")
    if env:
        return env
    Config.BASE_DIR.mkdir(parents=True, exist_ok=True)
    keyfile = Config.BASE_DIR / "secret.key"
    if keyfile.exists():
        key = keyfile.read_text().strip()
        if key:
            return key
    key = secrets.token_hex(32)
    keyfile.write_text(key)
    return key


def now_iso() -> str:
