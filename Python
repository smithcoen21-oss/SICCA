def create_app(dev_insecure_cookies: bool = False) -> Flask:
    Config.ensure_dirs()
    init_db()
    load_strength_factors()

    app = Flask(__name__, template_folder=None, static_folder=str(Config.APP_ROOT / "static"))
    loader, _ = build_template_loader()
    app.jinja_loader = loader
    app.config.update(
        SECRET_KEY=load_or_create_secret_key(),
        MAX_CONTENT_LENGTH=Config.MAX_CONTENT_LENGTH,
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_COOKIE_SECURE=(Config.COOKIE_SECURE and not dev_insecure_cookies),
        PERMANENT_SESSION_LIFETIME=Config.SESSION_LIFETIME_SECONDS,
        WTF_CSRF_ENABLED=True,
    )
    if Config.BEHIND_PROXY:
        n = Config.BEHIND_PROXY
        app.wsgi_app = ProxyFix(app.wsgi_app, x_for=n, x_proto=n, x_host=n)
    CSRFProtect(app)
    login_manager.init_app(app)
    login_manager.login_view = "login"

    def can_access(row: sqlite3.Row) -> bool:
        if current_user.is_admin():
            return True
        me = current_user.username.lower()
        return (row["created_by"].lower() == me or (row["assigned_to"] or "").lower() == me)

    def scope() -> Tuple[str, Tuple[Any, ...]]:
        if current_user.is_admin():
            return "1=1", ()
        me = current_user.username.lower()
        return "(LOWER(created_by) = ? OR LOWER(assigned_to) = ?)", (me, me)

    def fetch_case(case_id: str) -> sqlite3.Row:
        ok, _ = validate_case_id(case_id)
        if not ok:
            abort(404)
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?", (case_id,)).fetchone()
        if row is None or not can_access(row):
            abort(404)
        return row

    def fetch_records(case_id: str) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
        with db() as conn:
            sus = conn.execute("SELECT * FROM suspects WHERE case_id=? ORDER BY id", (case_id,)).fetchall()
            ev = conn.execute("SELECT * FROM evidence WHERE case_id=? ORDER BY id", (case_id,)).fetchall()
        return [dict(r) for r in sus], [dict(r) for r in ev]

    def sync_counts(conn: sqlite3.Connection, case_id: str) -> None:
        conn.execute(
            """UPDATE cases SET
               suspects_count = (SELECT COUNT(*) FROM suspects WHERE case_id = :c),
               evidence_count = (SELECT COUNT(*) FROM evidence WHERE case_id = :c),
               modified = :m WHERE case_id = :c""",
            {"c": case_id, "m": now_iso()})

    ml = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH, key=app.config["SECRET_KEY"].encode("utf-8"))
    engine = HybridEngine(ml=ml)

    @app.after_request
    def security_headers(resp):
        resp.headers.setdefault("X-Content-Type-Options", "nosniff")
        resp.headers.setdefault("X-Frame-Options", "DENY")
        resp.headers.setdefault("Referrer-Policy", "same-origin")
        if Config.CSP:
            resp.headers.setdefault("Content-Security-Policy", Config.CSP)
        if request.is_secure:
            resp.headers.setdefault("Strict-Transport-Security", "max-age=31536000; includeSubDomains")
        if current_user.is_authenticated:
            resp.headers["Cache-Control"] = "no-store"
        return resp

    @app.errorhandler(CSRFError)
    def csrf_error(_exc):
        return "Security token missing or expired.", 400

    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect(url_for("dashboard"))
        if request.method == "POST":
            username = clean_text(request.form.get("username"), 100)
            password = request.form.get("password", "")
            with db() as conn:
                row = conn.execute("SELECT id, username, password, role FROM users WHERE username = ?", (username,)).fetchone()
            if row and check_password_hash(row["password"], password):
                login_user(User(row["id"], row["username"], row["role"]))
                session.permanent = True
                audit(row["username"], "login", row["username"])
                return redirect(url_for("dashboard"))
            flash("Invalid credentials", "error")
            return render_template("login.html"), 401
        return render_template("login.html")

    @app.route("/logout", methods=["POST"])
    @login_required
    def logout():
        audit(current_user.username, "logout", current_user.username)
        logout_user()
        session.clear()
        return redirect(url_for("login"))

    @app.route("/")
    @login_required
    def index():
        return redirect(url_for("dashboard"))

    @app.route("/dashboard")
    @login_required
    def dashboard():
        where, params = scope()
        with db() as conn:
            rows = conn.execute(f"SELECT * FROM cases WHERE {where} ORDER BY modified DESC LIMIT 100", params).fetchall()
            total = conn.execute(f"SELECT COUNT(*) AS n FROM cases WHERE {where}", params).fetchone()["n"]
        return render_template("dashboard.html", cases=[dict(r) for r in rows], stats={"total_cases": total})

    @app.route("/create_case", methods=["GET", "POST"])
    @login_required
    def create_case():
        if request.method == "GET":
            return render_template("create_case.html", types=CASE_TYPES, statuses=STATUSES, priorities=PRIORITIES)
        try:
            case_id = clean_text(request.form.get("case_id"), 50)
            ok, msg = validate_case_id(case_id)
            if not ok: raise FormError(msg)
            record = build_case_record(request.form, case_id, current_user.username)
        except FormError as exc:
            flash(str(exc), "error")
            return render_template("create_case.html", types=CASE_TYPES, statuses=STATUSES, priorities=PRIORITIES), 400
        with db() as conn:
            conn.execute(
                """INSERT INTO cases (case_id, case_name, location, year, type, status, confidence, 
                suspects_count, evidence_count, description, priority, assigned_to, tags, 
                created_by, active_since, created, modified)
                VALUES (:case_id, :case_name, :location, :year, :type, :status, :confidence,
                :suspects_count, :evidence_count, :description, :priority, :assigned_to, :tags,
                :created_by, :active_since, :created, :modified)""", record)
        flash(f"Case {case_id} created.", "success")
        return redirect(url_for("view_case", case_id=case_id))

    @app.route("/case/<case_id>")
    @login_required
    def view_case(case_id: str):
        row = fetch_case(case_id)
        suspects, evidence = fetch_records(case_id)
        return render_template("view_case.html", case=dict(row), suspects=suspects, evidence=evidence)

    @app.route("/case/<case_id>/suspects", methods=["POST"])
    @login_required
    def add_suspect(case_id: str):
        fetch_case(case_id)
        name = clean_text(request.form.get("name"), 200)
        if not name:
            flash("Suspect name required.", "error")
            return redirect(url_for("view_case", case_id=case_id))
        with db() as conn:
            conn.execute(
                "INSERT INTO suspects (case_id, name, aliases, identifier, role, notes, created) VALUES (?,?,?,?,?,?,?)",
                (case_id, name, clean_text(request.form.get("aliases"), 400),
                 clean_text(request.form.get("identifier"), 100),
                 clean_text(request.form.get("role", "suspect"), 40),
                 clean_text(request.form.get("notes"), 2000), now_iso()))
            sync_counts(conn, case_id)
        flash("Suspect added.", "success")
        return redirect(url_for("view_case", case_id=case_id))

    @app.route("/case/<case_id>/evidence", methods=["POST"])
    @login_required
    def add_evidence(case_id: str):
        fetch_case(case_id)
        label = clean_text(request.form.get("label"), 200)
        if not label:
            flash("Evidence label required.", "error")
            return redirect(url_for("view_case", case_id=case_id))
        with db() as conn:
            conn.execute(
                "INSERT INTO evidence (case_id, label, kind, identifier, notes, created) VALUES (?,?,?,?,?,?)",
                (case_id, label, clean_text(request.form.get("kind", "other"), 40).lower(),
                 clean_text(request.form.get("identifier"), 100),
                 clean_text(request.form.get("notes"), 2000), now_iso()))
            sync_counts(conn, case_id)
        flash("Evidence added.", "success")
        return redirect(url_for("view_case", case_id=case_id))

    # Cross-match engine route implementation
    def run_cross_match(case_ids: List[str], command: str):
        case_ids = list(dict.fromkeys(i.strip() for i in case_ids if i.strip()))
        if len(case_ids) < 2:
            return {"error": "Cross-match needs at least two cases."}, 400
        if not TRIGGER_RE.search(command or ""):
            return {"error": "Command not recognized. Try 'similarities'."}, 400
        marks = ",".join("?" * len(case_ids))
        with db() as conn:
            rows = conn.execute(f"SELECT * FROM cases WHERE case_id IN ({marks})", case_ids).fetchall()
        cases = [dict(r) for r in rows]
        for c in cases:
            c["suspects"], c["evidence"] = fetch_records(c["case_id"])
        results = cross_match(cases)
        return {"command": command, "cases_compared": len(cases), "matches": results}, 200

    @app.route("/cross_match", methods=["GET", "POST"])
    @login_required
    def cross_match_route():
        if request.method == "GET":
            with db() as conn:
                rows = conn.execute("SELECT case_id, case_name FROM cases ORDER BY modified DESC").fetchall()
            return render_template("cross_match.html", cases=[dict(r) for r in rows], result=None, error=None)
        if request.is_json:
            data = request.get_json(silent=True) or {}
            ids = data.get("case_ids", [])
            if isinstance(ids, str): ids = ids.split(",")
            payload, status = run_cross_match([str(i) for i in ids], str(data.get("command", "")))
            return jsonify(payload), status
        ids = request.form.getlist("case_ids")
        payload, status = run_cross_match(ids, request.form.get("command", ""))
        with db() as conn:
            rows = conn.execute("SELECT case_id, case_name FROM cases ORDER BY modified DESC").fetchall()
        return render_template("cross_match.html", cases=[dict(r) for r in rows], selected=ids,
                               result=payload if status == 200 else None, error=payload.get("error") if status != 200 else None)

    @app.route("/analyze/<case_id>")
    @login_required
    def analyze_case(case_id: str):
        row = fetch_case(case_id)
        result = engine.analyze(dict(row))
        if request.args.get("format") == "json":
            return jsonify(result)
        return render_template("analysis.html", case=dict(row), result=result)

    @app.route("/corpus")
    @login_required
    def corpus_dashboard():
        with db() as conn:
            total = conn.execute("SELECT COUNT(*) AS n FROM cases").fetchone()["n"]
        return render_template("corpus_dashboard.html", total=total)

    @app.route("/admin/train", methods=["GET", "POST"])
    @admin_required
    def train_model():
        if request.method == "POST":
            f = request.files.get("training_csv")
            if f and f.filename.lower().endswith(".csv"):
                try:
                    ml.train(pd.read_csv(f.stream))
                    flash("Model trained successfully.", "success")
                except Exception as exc:
                    flash(str(exc), "error")
        return render_template("train.html")

    return app


def main():
    init_db()
    load_strength_factors()
    create_app().run(host=Config.HOST, port=Config.PORT, debug=Config.DEBUG)


if __name__ == "__main__":
