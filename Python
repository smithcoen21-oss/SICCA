class CrossBorderHeuristics:
    """
    Transparent rule-based scoring. The original code called this "ML" and
    reported an invented accuracy_estimate of 0.85 -- both removed.
    """

    @staticmethod
    def risk(case: Dict[str, Any]) -> Dict[str, Any]:
        crime_risk = {
            "violent_crime": 0.8, "sexual_violence": 0.9,
            "terrorism": 1.0, "organized_crime": 0.7,
            "financial_crime": 0.4, "property_crime": 0.3,
        }.get(str(case.get("crime_category", "other_crime")), 0.5)

        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        score = (0.6 * crime_risk
                 + 0.2 * min(1.0, ev / 10.0)
                 + 0.2 * min(1.0, su / 5.0))
        level = "HIGH" if score > 0.7 else "MEDIUM" if score > 0.4 else "LOW"
        return {
            "risk_score": round(score, 3),
            "risk_level": level,
            "method": "transparent_heuristic",
            "factors": ["crime_category", "evidence_count", "suspects_count"],
        }


