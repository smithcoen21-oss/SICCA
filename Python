    def _signatures_for(cases: List[dict]) -> Dict[str, dict]:
        """Condition signature for every case using a handful of queries in
        total (not several per case)."""
        empty = {"temporal": [], "weather": [], "mo": [], "all": []}
        if linkage is None:
            return {c["case_id"]: dict(empty) for c in cases}
        ids = [c["case_id"] for c in cases]
        windows: List[dict] = []
        conds: List[dict] = []
        obs_by_case: Dict[str, List[dict]] = defaultdict(list)
        mo_by_case: Dict[str, List[str]] = defaultdict(list)
        with db() as conn:
            if temporal is not None and _table_exists(conn, "time_window"):
                windows = [dict(w) for w in conn.execute(
                    "SELECT * FROM time_window")]
            if (weather is not None
                    and _table_exists(conn, "weather_condition")
                    and _table_exists(conn, "case_weather")):
                conds = [dict(r) for r in conn.execute(
                    "SELECT * FROM weather_condition")]
                for chunk in _chunks(ids):
                    ph = ",".join("?" * len(chunk))
                    for r in conn.execute(
                            f"SELECT * FROM case_weather "
                            f"WHERE case_id IN ({ph})", chunk):
                        obs_by_case[r["case_id"]].append(dict(r))
            if _table_exists(conn, "case_method"):
                for chunk in _chunks(ids):
                    ph = ",".join("?" * len(chunk))
                    for r in conn.execute(
                            f"SELECT case_id, method_id FROM case_method "
                            f"WHERE case_id IN ({ph})", chunk):
                        mo_by_case[r["case_id"]].append(r["method_id"])
        out: Dict[str, dict] = {}
        for case in cases:
            cid = case["case_id"]
            t_matched: List[str] = []
            w_matched: List[str] = []
            if windows:
                try:
                    prof = temporal.temporal_profile(case, windows)
                    if prof.get("ok"):
                        t_matched = [m["window_id"]
                                     for m in prof.get("matched", [])]
                except Exception:
                    LOG.exception("temporal signature failed for %s", cid)
            if conds:
                try:
                    wprof = weather.weather_profile(obs_by_case.get(cid, []),
                                                    conds)
                    if wprof.get("ok"):
                        w_matched = list(
                            wprof.get("matched_condition_ids", []))
                except Exception:
                    LOG.exception("weather signature failed for %s", cid)
            out[cid] = linkage.build_signature(
                temporal_matched=t_matched,
                weather_matched=w_matched,
                mo_matched=mo_by_case.get(cid, []),
            )
        return out

