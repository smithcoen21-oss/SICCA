    @login_required
    def network_graph():
        prior = parse_prior(request.args.get("prior"))
        try:
            floor = float(request.args.get("floor", 10.0))
        except (TypeError, ValueError):
            floor = 10.0
        floor = max(0.0, min(100.0, floor))
        with db() as c:
            cases = [dict(r) for r in c.execute("SELECT case_id,case_name,type,status,priority FROM 
cases ORDER BY case_id")]
            scores = pairwise_scores(c, prior)
        nodes = [{"id": cs["case_id"], "label": cs["case_id"],
                  "title": f"{cs['case_id']}: {cs['case_name']} | Type: {cs['type']} | Status: {cs['status']} | 
Priority: {cs['priority']}",
                  "group": cs["type"], "url": url_for("view_case", case_id=cs["case_id"])} for cs in cases]
        edges = []
        for (a, b), r in scores.items():
            pct
 = r["post"] * 100.0
            if pct < floor:
                continue
            hue = 120 * (1 - min(1.0, pct / 100.0))
            edges.append({"from": a, "to": b, "value": pct,
                          "title":
 f"{a} and {b}: {pct:.1f}% posterior, LR {r['combined_lr']:.2f}x",
                          "url":
 url_for("compare", a=a, b=b, prior=prior),
                          "color": f"hsl({hue:.0f},65%,50%)"})
        return render_template("network_graph.html", prior=prior, floor=floor,
                               n_nodes=len(nodes), n_edges=len(edges),
                               nodes_json=json.dumps(nodes), edges_json=json.dumps(edges))
