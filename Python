    try:
        floor = float(request.args.get("floor", 5.0))
    except (TypeError, ValueError):
        floor = 5.0
    floor = max(0.0, min(100.0, floor))
    with db() as c:
        cases = [dict(r) for r in c.execute("SELECT case_id,case_name FROM cases ORDER BY case_id")]
        scores = pairwise_scores(c, prior)
    cell: Dict[tuple, Dict[str, float]] = {}
    row_max: Dict[str, float] = {cs["case_id"]: 0.0 for cs in cases}
    global_max = 0.0
    for (a, b), r in scores.items():
        pct = r["post"] * 100.0
        cell[(a, b)] = {"pct": pct, "p5": r["p5"] * 100.0,
                        "p95": r["p95"] * 100.0, "lr": r["combined_lr"]}
        if pct > row_max.get(a, 0):
            row_max[a] = pct
        if pct > row_max.get(b, 0):
            row_max[b] = pct
        if pct > global_max:
            global_max = pct
    cases.sort(key=lambda cs: -row_max.get(cs["case_id"], 0.0))
    return render_template("matrix.html", cases=cases, cell=cell, prior=prior,
                           floor=floor, row_max=row_max, global_max=global_max)

