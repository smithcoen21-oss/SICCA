add("make_zip.py", r'''
#!/usr/bin/env python3
"""Zip up the SICCA project tree and print a manifest."""
import zipfile
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
OUT = ROOT / f"sicca-complete-{datetime.now():%Y%m%d}.zip"

INCLUDE = [
    "sicca_app.py", "sicca_calibration.py", "requirements.txt",
    "templates/",
]

def main() -> None:
    written = []
    with zipfile.ZipFile(OUT, "w", zipfile.ZIP_DEFLATED) as z:
        for entry in INCLUDE:
            p = ROOT / entry
            if p.is_dir():
                for f in sorted(p.rglob("*")):
                    if f.is_file() and "__pycache__" not in f.parts:
                        rel = f.relative_to(ROOT)
                        z.write(f, rel)
                        written.append(str(rel))
            elif p.is_file():
                rel = p.relative_to(ROOT)
                z.write(p, rel)
                written.append(str(rel))
            else:
                print(f"  (skipped, not found) {entry}")
        manifest = "\n".join(sorted(written))
        z.writestr("MANIFEST.txt",
                   f"SICCA bundle generated {datetime.now().isoformat()}\n"
                   f"{len(written)} files\n\n{manifest}\n")
    print(f"\nWrote {OUT}")
    print(f"{len(written)} files inside:")
    for name in sorted(written):
        print(f"  {name}")


if __name__ == "__main__":
    main()
''')


# =============================================================================
# RUNNER
# =============================================================================

def write_tree(target: Path, force: bool) -> tuple[int, int]:
    """Write every embedded file to `target`. Returns (written, skipped)."""
    written = 0
    skipped = 0
    target = target.resolve()
    target.mkdir(parents=True, exist_ok=True)
    for rel, content in FILES:
        dest = target / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.exists() and not force:
            print(f"  skip (exists)  {rel}")
            skipped += 1
            continue
        dest.write_text(content, encoding="utf-8")
        print(f"  wrote          {rel}  ({len(content):,} bytes)")
        written += 1
    return written, skipped


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Write the SICCA project tree to a directory.")
    ap.add_argument("target", nargs="?", default="sicca_build",
                    help="target directory (default: ./sicca_build)")
    ap.add_argument("--force", action="store_true",
                    help="overwrite existing files")
    args = ap.parse_args()

    target = Path(args.target)
    print(f"SICCA installer -- writing {len(FILES)} files to {target.resolve()}")
    print()
    written, skipped = write_tree(target, args.force)
    print()
    print(f"Done. {written} file(s) written, {skipped} skipped.")
    print()
    print("Next steps:")
