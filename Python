@contextmanager
def db():
    """Connection that always commits-or-rolls-back and is always closed."""
    conn = sqlite3.connect(Config.CASES_DB, timeout=15)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


USERNAME_RE = re.compile(r"^[A-Za-z0-9_.\-]{3,50}$")
MIN_PASSWORD_LEN = 10


def create_user(username: str, password: str, role: str = "analyst") -> None:
    if not USERNAME_RE.match(username):
        raise ValueError("Username must be 3-50 chars: letters, digits, . _ -")
    if len(password) < MIN_PASSWORD_LEN:
        raise ValueError(f"Password must be at least {MIN_PASSWORD_LEN} characters.")
    if role not in ("admin", "analyst"):
        raise ValueError("Role must be 'admin' or 'analyst'.")
    with db() as conn:
        conn.execute(
            "INSERT INTO users (username, password, role) VALUES (?,?,?)",
            (username, generate_password_hash(password), role),
        )


def init_db() -> None:
    Config.ensure_dirs()
    with db() as conn:
        conn.execute("PRAGMA journal_mode = WAL")
        conn.executescript(SCHEMA)
        # Migration for databases created by v2.0 (no created_by column).
        cols = {r["name"] for r in conn.execute("PRAGMA table_info(cases)")}
        if "created_by" not in cols:
            conn.execute("ALTER TABLE cases ADD COLUMN "
                         "created_by TEXT NOT NULL DEFAULT ''")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_cases_creator "
                     "ON cases(created_by)")
        n_users = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()["n"]

    if n_users:
        return
    username = os.environ.get("SICCA_ADMIN_USER", "admin")
    supplied = os.environ.get("SICCA_ADMIN_PASS")
    password = supplied or secrets.token_urlsafe(14)
    try:
        create_user(username, password, "admin")
    except sqlite3.IntegrityError:
        return  # another worker seeded it first
    if supplied:
        LOG.info("Seeded admin user '%s' from SICCA_ADMIN_PASS.", username)
    else:
        # Printed to the terminal only. It is deliberately NOT sent to the log
        # file, so it cannot end up in backups or log shippers.
        LOG.warning("Seeded admin user '%s' with a generated password "
                    "(shown once on stderr).", username)
        print(f"\n*** SICCA initial admin login ***\n  user: {username}\n"
              f"  pass: {password}\nStore it now; it is not saved anywhere.\n",
              file=sys.stderr)


def audit(actor: str, action: str, target: str, details: str = "",
          conn: Optional[sqlite3.Connection] = None) -> None:
    """Pass `conn` to make the audit row part of the caller's transaction."""
    sql = ("INSERT INTO audit_log (ts, actor, action, target, details) "
           "VALUES (?,?,?,?,?)")
    params = (now_iso(), actor, action, target, details)
    if conn is not None:
        conn.execute(sql, params)
    else:
        with db() as c:
            c.execute(sql, params)


