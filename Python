def create_app() -> Flask:
    Config.ensure_dirs()
    init_db()
    check_risk_reachability()

    app = Flask(__name__, template_folder=None,
                static_folder=str(Config.APP_ROOT / "static"))
    loader, _ = build_template_loader()
    app.jinja_loader = loader
    app.config.update(
        SECRET_KEY=load_or_create_secret_key(),
        MAX_CONTENT_LENGTH=Config.MAX_CONTENT_LENGTH,
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_COOKIE_SECURE=Config.COOKIE_SECURE,
        PERMANENT_SESSION_LIFETIME=Config.SESSION_LIFETIME_SECONDS,
        WTF_CSRF_ENABLED=True,
    )
    CSRFProtect(app)
    login_manager.init_app(app)
    login_manager.login_view = "login"

    ml = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH)
    engine = HybridEngine(ml)

    # -------------------------------------------------------------- helpers
    def can_access(row: sqlite3.Row) -> bool:
        if current_user.is_admin():
            return True
        me = current_user.username.lower()
        return (row["created_by"].lower() == me
                or (row["assigned_to"] or "").lower() == me)

    def scope() -> Tuple[str, Tuple[Any, ...]]:
        if current_user.is_admin():
            return "1=1", ()
        me = current_user.username.lower()
        return "(LOWER(created_by) = ? OR LOWER(assigned_to) = ?)", (me, me)

    def fetch_case(case_id: str) -> sqlite3.Row:
        ok, _ = validate_case_id(case_id)
        if not ok:
            abort(404)
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?",
                               (case_id,)).fetchone()
        if row is None or not can_access(row):
            abort(404)
        return row

    def render_create(status: int = 200, **extra):
        return render_template(
            "create_case.html",
            form=request.form if request.method == "POST" else {},
            types=CASE_TYPES, statuses=STATUSES,
            priorities=PRIORITIES, **extra), status

    # -------------------------------------------------------------- hooks
    @app.after_request
    def security_headers(resp):
        resp.headers.setdefault("X-Content-Type-Options", "nosniff")
        resp.headers.setdefault("X-Frame-Options", "DENY")
        resp.headers.setdefault("Referrer-Policy", "same-origin")
        if current_user.is_authenticated:
            resp.headers["Cache-Control"] = "no-store"
        return resp

    @app.errorhandler(CSRFError)
    def csrf_error(_exc):
        return ("Security token missing or expired. Go back, reload the "
                "page and try again.", 400)

    @app.errorhandler(413)
    def too_large(_exc):
        mb = Config.MAX_CONTENT_LENGTH // (1024 * 1024)
        return f"Upload too large (limit {mb} MB).", 413

    # -------------------------------------------------------------- auth
    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect(url_for("dashboard"))
        if request.method == "POST":
            username = clean_text(request.form.get("username"), 100)
            password = request.form.get("password", "")
            ip = request.remote_addr or "?"
            k_user, k_ip = f"u:{ip}|{username.lower()}", f"ip:{ip}"
            wait = max(THROTTLE.wait_seconds(k_user, 5),
                       THROTTLE.wait_seconds(k_ip, 30))
            if wait:
                flash(f"Too many failed attempts. Try again in "
                      f"{wait // 60 + 1} minute(s).", "error")
                return render_template("login.html"), 429
            with db() as conn:
                row = conn.execute(
                    "SELECT id, username, password, role FROM users "
                    "WHERE username = ?", (username,)).fetchone()
            valid = check_password_hash(
                row["password"] if row else _DUMMY_HASH, password)
            if row and valid:
                THROTTLE.clear(k_user)
                session.clear()
                login_user(User(row["id"], row["username"], row["role"]))
                session.permanent = True
                audit(row["username"], "login", row["username"])
                return redirect(url_for("dashboard"))
            THROTTLE.fail(k_user)
            THROTTLE.fail(k_ip)
            LOG.warning("Failed login for '%s' from %s", username[:50], ip)
            flash("Invalid credentials", "error")
            return render_template("login.html"), 401
        return render_template("login.html")

    @app.route("/logout", methods=["POST"])
    @login_required
    def logout():
        audit(current_user.username, "logout", current_user.username)
        logout_user()
        session.clear()
        return redirect(url_for("login"))

