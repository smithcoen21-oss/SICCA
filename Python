    def ensure_default_hypotheses(conn, a: str, b: str, prior: float) -> List[Dict[str, Any]]:
        x, y = sorted((a, b))
        existing = [dict(r) for r in conn.execute(
            "SELECT * FROM hypotheses WHERE pair_a=? AND pair_b=? ORDER BY 
hypothesis_id", (x, y)).fetchall()]
        if existing:
            return existing
        rows = [
            (f"H1-{x}-{y}", x, y, "Shared perpetrator",
             "One or more individuals operated across both cases.",
             prior, 1),
            (f"H2-{x}-{y}", x, y, "Unrelated",
             "The two cases have no connection; any overlap is coincidental.",
             max(0.0, 1.0 - prior - 0.20), 0),
            (f"H3-{x}-{y}", x, y, "Shared environment only",
             "Same region and era, but no shared individual.",
             0.20, 0),
        ]
        for hid, ca, cb, label, desc, hp, isdef in rows:
            conn.execute("INSERT OR IGNORE INTO 
hypotheses(hypothesis_id,pair_a,pair_b,label,description,prior,is_default,created_by,created) 
VALUES(?,?,?,?,?,?,?,?,?)",
                         (hid, ca, cb, label, desc, hp, isdef, current_user.username, now_iso()))
        return [dict(r) for r in conn.execute(
            "SELECT * FROM hypotheses WHERE pair_a=? AND pair_b=? ORDER BY 
hypothesis_id", (x, y)).fetchall()]
