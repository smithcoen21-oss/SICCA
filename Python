    # ---------------------------------------------------------------- create
    @app.route("/create_case", methods=["GET", "POST"])
    @login_required
    def create_case():
        if request.method == "POST":
            case_id = clean_text(request.form.get("case_id"), 50)
            ok, msg = validate_case_id(case_id)
            if not ok:
                flash(msg, "error")
                return render_template("create_case.html"), 400

            # FIX #5: validate BEFORE saving the file to disk.
            file = request.files.get("case_file")
            saved_path = None
            attached = None
            if file and file.filename:
                ext = Path(file.filename).suffix.lower()
                if ext not in Config.ALLOWED_UPLOAD_EXTENSIONS:
                    flash(f"File type {ext} not allowed", "error")
                    return render_template("create_case.html"), 400
                safe_name = safe_upload_name(case_id, file.filename)
                saved_path = Config.UPLOADS_DIR / safe_name
                file.save(saved_path)
                attached = file.filename

            now = datetime.utcnow().isoformat()
            record = {
                "case_id": case_id,
                "case_name": clean_text(request.form.get("case_name"), 200),
                "location": clean_text(request.form.get("location"), 200),
                "year": coerce_int(request.form.get("year"),
                                   datetime.now().year, 1900, 2100),
                "type": clean_text(request.form.get("type", "unknown"), 40),
                "status": clean_text(request.form.get("status", "open"), 40),
                "confidence": coerce_float(request.form.get("confidence"),
                                           0.5, 0.0, 1.0),
                "suspects_count": coerce_int(
                    request.form.get("suspects_count"), 0, 0, 1000),
                "evidence_count": coerce_int(
                    request.form.get("evidence_count"), 0, 0, 10000),
                "description": clean_text(
                    request.form.get("description"), 5000),
                "priority": clean_text(
                    request.form.get("priority", "medium"), 20),
                "assigned_to": clean_text(
                    request.form.get("assigned_to"), 100),
                "tags": clean_text(request.form.get("tags"), 500),
                "attached_file": attached,
                "file_path": str(saved_path) if saved_path else None,
                "created": now,
                "modified": now,
            }

            try:
                with db() as conn:
                    conn.execute(
                        """INSERT INTO cases (case_id, case_name, location,
                        year, type, status, confidence, suspects_count,
                        evidence_count, description, priority, assigned_to,
                        tags, attached_file, file_path, created, modified)
                        VALUES (:case_id, :case_name, :location, :year, :type,
                        :status, :confidence, :suspects_count, :evidence_count,
                        :description, :priority, :assigned_to, :tags,
                        :attached_file, :file_path, :created, :modified)""",
                        record,
                    )
                    conn.commit()
                audit(current_user.username, "create_case", case_id)
                flash(f"Case {case_id} created.", "success")
                return redirect(url_for("view_case", case_id=case_id))
            except sqlite3.IntegrityError:
                flash("Case ID already exists", "error")
                return render_template("create_case.html"), 409
            except Exception as exc:
                # FIX #17: do not swallow; surface to the user.
                LOG.exception("Failed to write case")
                flash(f"Failed to save case: {exc}", "error")
                return render_template("create_case.html"), 500

        return render_template("create_case.html")

