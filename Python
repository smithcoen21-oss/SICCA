def clean_text(value: Any, max_len: int = 1000, multiline: bool = False) -> str:
    if value is None:
        return ""
    text = str(value).replace("\x00", "")
    if multiline:
        text = "".join(ch for ch in text if ch in "\n\t" or ord(ch) >= 32)
    else:
        text = "".join(" " if ch in "\r\n\t" else ch for ch in text if ch in "\r\n\t" or ord(ch) >= 32)
    return text.strip()[:max_len]


def log_safe(value: Any, max_len: int = 50) -> str:
    return str(value)[:max_len].encode("unicode_escape").decode("ascii")


def _pretty(obj: Any) -> str:
    try:
        return json.dumps(obj, indent=2, default=str, sort_keys=True)
    except Exception:
        return repr(obj)


def _chunks(seq: List[Any], size: int = 500):
