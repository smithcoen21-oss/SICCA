# BAYESIAN MODEL (heuristic and UNCALIBRATED - decision support only)
# =============================================================================

def _env_float(name: str, default: float, lo: float, hi: float) -> float:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        x = float(raw)
    except ValueError:
        raise RuntimeError(f"{name} must be a number, got {raw!r}.")
    if not isfinite(x) or not lo <= x <= hi:
        raise RuntimeError(f"{name} must be between {lo} and {hi}.")
    return x


class BayesianConfig:
    BASE_PRIOR = 0.30
    TYPE_LR = {
        "fraud": 1.2, "homicide": 2.0, "robbery": 1.6, "arson": 1.8,
        "burglary": 1.4, "assault": 1.7, "theft": 1.3,
        "vandalism": 1.1, "unknown": 1.0,
    }
    # Shared by the score, the trace, the sensitivity grid and the CLI so the
    # four can never drift apart.
    STATUS_LR = {"open": 1.05, "under investigation": 1.15,
                 "pending trial": 1.25, "closed": 0.90}
    PRIORITY_LR = {"high": 1.10, "medium": 1.00, "low": 0.90}
    # MO attribution: LR = 1 + (MO_LR_MAX - 1) * attribution_confidence.
    MO_LR_MAX = 1.5
    AGE_DECAY_LAMBDA = 0.05
    MAX_FEATURE_LR = 6.0
    MIN_FEATURE_LR = 0.25
    HIGH = _env_float("SICCA_HIGH", 0.70, 0.0, 1.0)
    MEDIUM = _env_float("SICCA_MEDIUM", 0.40, 0.0, 1.0)


if not BayesianConfig.MEDIUM < BayesianConfig.HIGH:
    raise RuntimeError("SICCA_MEDIUM must be lower than SICCA_HIGH.")


def risk_level(score: float) -> str:
    return ("high" if score > BayesianConfig.HIGH
            else "medium" if score > BayesianConfig.MEDIUM else "low")


def _odds(p: float) -> float:
    p = min(max(p, 1e-6), 1 - 1e-6)
    return p / (1 - p)


def _prob(o: float) -> float:
    return o / (1 + o)


# Cached multiplier table for evidence strength. Populated at startup.
_EVIDENCE_STRENGTH_CACHE: Dict[str, float] = {}


def load_strength_factors() -> None:
    """Populate the strength cache from the reference table."""
    global _EVIDENCE_STRENGTH_CACHE
    try:
        with db() as conn:
            rows = conn.execute(
                "SELECT strength, multiplier FROM evidence_strength_factor"
            ).fetchall()
        _EVIDENCE_STRENGTH_CACHE = {r["strength"]: float(r["multiplier"])
                                    for r in rows}
    except sqlite3.OperationalError:
        _EVIDENCE_STRENGTH_CACHE = {}
    if not _EVIDENCE_STRENGTH_CACHE:
        _EVIDENCE_STRENGTH_CACHE = {"weak": 0.7, "moderate": 1.0, "strong": 1.5}


def _evidence_lr(evidence_count: int, suspects_count: int,
                 status: str, priority: str,
                 strength: str = "moderate") -> float:
    ev = 1.0 + 0.35 * float(np.log1p(max(0, evidence_count)))
    su = 1.0 + 0.10 * max(0, suspects_count - 1)
    st = BayesianConfig.STATUS_LR.get(status.lower(), 1.0)
    pr = BayesianConfig.PRIORITY_LR.get(priority.lower(), 1.0)
    sf = _EVIDENCE_STRENGTH_CACHE.get(str(strength).lower(), 1.0)
    lr = float(ev * su * st * pr * sf)
    return max(BayesianConfig.MIN_FEATURE_LR,
               min(BayesianConfig.MAX_FEATURE_LR, lr))


def _investigation_age_years(case: Mapping[str, Any],
                             current_year: int) -> int:
    """
    Age of the current investigation in whole years. Uses active_since
    if present (the date the current investigation started or was
    reopened). Falls back to the event year.
    """
    active_since = case.get("active_since")
    if active_since:
        try:
            start_year = int(str(active_since)[:4])
        except (TypeError, ValueError):
            start_year = coerce_int(case.get("year", current_year),
                                    current_year, 1900, 2100)
    else:
        start_year = coerce_int(case.get("year", current_year),
                                current_year, 1900, 2100)
    return max(0, current_year - start_year)


def bayesian_score(case: Mapping[str, Any], current_year: int) -> Dict[str, Any]:
    ctype = str(case.get("type", "unknown")).lower()
    type_lr = BayesianConfig.TYPE_LR.get(ctype, 1.0)
    ev_lr = _evidence_lr(
        coerce_int(case.get("evidence_count", 0), 0, 0, 10000),
        coerce_int(case.get("suspects_count", 0), 0, 0, 1000),
        str(case.get("status", "open")),
        str(case.get("priority", "medium")),
        str(case.get("evidence_strength", "moderate")),
    )
    posterior = _prob(_odds(BayesianConfig.BASE_PRIOR) * type_lr * ev_lr)
    base_conf = coerce_float(case.get("confidence", 0.5), 0.5, 0.0, 1.0)
    age = _investigation_age_years(case, current_year)
    decayed_conf = max(0.0, min(1.0, base_conf * exp(
        -BayesianConfig.AGE_DECAY_LAMBDA * age)))
    adjusted = posterior * (0.5 + 0.5 * decayed_conf)
    return {
        "posterior": float(posterior),
        "adjusted_posterior": float(adjusted),
        "confidence": float(decayed_conf),
        "prior_used": BayesianConfig.BASE_PRIOR,
        "type_likelihood_ratio": float(type_lr),
        "evidence_likelihood_ratio": float(ev_lr),
        "evidence_strength": str(case.get("evidence_strength", "moderate")),
        "investigation_age_years": int(age),
        "event_year": coerce_int(case.get("year", current_year),
                                 current_year, 1900, 2100),
        "risk_level": risk_level(adjusted),
        "calibrated": False,
    }


def max_reachable_score(ctype: str) -> float:
    lr = (BayesianConfig.TYPE_LR.get(ctype, 1.0)
          * BayesianConfig.MAX_FEATURE_LR)
    return _prob(_odds(BayesianConfig.BASE_PRIOR) * lr)


def min_confidence_for_high(ctype: str) -> Optional[float]:
    """Smallest (decayed) confidence at which `ctype` can be rated 'high',
    given adjusted = posterior * (0.5 + 0.5 * confidence). None if never."""
    top = max_reachable_score(ctype)
    if top <= BayesianConfig.HIGH:
        return None
    return max(0.0, 2.0 * BayesianConfig.HIGH / top - 1.0)


def check_risk_reachability() -> None:
    for ctype in CASE_TYPES:
        need = min_confidence_for_high(ctype)
        if need is None:
            LOG.warning("Risk config: '%s' can never exceed %.2f, so it can "
                        "never be rated 'high'.", ctype,
                        max_reachable_score(ctype))
        elif need > 0.9:
            LOG.warning("Risk config: '%s' can only be rated 'high' with "
                        "maxed-out evidence AND decayed confidence >= %.2f "
                        "(i.e. a brand-new case). Consider lowering "
                        "SICCA_HIGH.", ctype, need)


