@contextmanager
def db():
    conn = sqlite3.connect(Config.CASES_DB, timeout=15)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


USERNAME_RE = re.compile(r"^[A-Za-z0-9_.\-]{3,50}$")
MIN_PASSWORD_LEN = 10


def create_user(username: str, password: str, role: str = "analyst") -> None:
    if not USERNAME_RE.match(username):
        raise ValueError("Username must be 3-50 chars: letters, digits, . _ -")
    if len(password) < MIN_PASSWORD_LEN:
        raise ValueError(f"Password must be at least {MIN_PASSWORD_LEN} characters.")
    if role not in ("admin", "analyst"):
        raise ValueError("Role must be 'admin' or 'analyst'.")
    with db() as conn:
        conn.execute(
            "INSERT INTO users (username, password, role) VALUES (?,?,?)",
            (username, generate_password_hash(password), role),
        )


def init_db() -> None:
    Config.ensure_dirs()
    with db() as conn:
        conn.execute("PRAGMA journal_mode = WAL")
        conn.executescript(SCHEMA)
        cols = {r["name"] for r in conn.execute("PRAGMA table_info(cases)")}
        if "created_by" not in cols:
            conn.execute("ALTER TABLE cases ADD COLUMN created_by TEXT NOT NULL DEFAULT ''")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_cases_creator ON cases(created_by)")
        if "evidence_strength" not in cols:
            conn.execute("ALTER TABLE cases ADD COLUMN evidence_strength TEXT NOT NULL DEFAULT 'moderate'")
        if "active_since" not in cols:
            conn.execute("ALTER TABLE cases ADD COLUMN active_since TEXT")
        if "reopened_count" not in cols:
            conn.execute("ALTER TABLE cases ADD COLUMN reopened_count INTEGER NOT NULL DEFAULT 0")
        conn.execute(
            "UPDATE cases SET active_since = printf('%04d-07-01', year) WHERE active_since IS NULL")
        conn.execute(
            "INSERT OR IGNORE INTO evidence_strength_factor (strength, multiplier, description) VALUES "
            "('weak', 0.7, 'Circumstantial, low quality, or uncertain provenance'), "
            "('moderate', 1.0, 'Concrete and attributable (default)'), "
            "('strong', 1.5, 'Decisive: direct physical trace, credible witness, or admission')")
        n_users = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()["n"]
        if n_users:
            return
    username = os.environ.get("SICCA_ADMIN_USER", "admin")
    supplied = os.environ.get("SICCA_ADMIN_PASS")
    password = supplied or secrets.token_urlsafe(14)
    try:
        create_user(username, password, "admin")
    except sqlite3.IntegrityError:
        return
    if supplied:
        LOG.info("Seeded admin user '%s' from SICCA_ADMIN_PASS.", username)
    else:
        print(f"\n*** SICCA initial admin login ***\n user: {username}\n pass: {password}\n", file=sys.stderr)


