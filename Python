SICCA installer.

Writes the complete project tree -- application, calibration module,
templates, and helper scripts -- to a target directory. Every file is
embedded in this script, so it needs no network access and no source
tree to run.


After assembly, run:

    python install_sicca.py [target-directory]

Default target is ./sicca_build. The installer refuses to overwrite
files unless --force is passed.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path


# =============================================================================
# EMBEDDED FILES
# -----------------------------------------------------------------------------
# Each entry is (relative_path, text_content).
# =============================================================================

FILES: list[tuple[str, str]] = []


def add(path: str, content: str) -> None:
    """Register an embedded file. Leading newline is stripped so the
    source stays readable in this script."""
    FILES.append((path, content.lstrip("\n")))


# -----------------------------------------------------------------------------
# requirements.txt
