CATEGORIES = {

    "forensic_match": (10.0, "Forensic or physical match (DNA, tool marks, shared object)"),

    "shared_person": (8.0, "Same person verified as involved in both cases"),

    "method_match": (3.0, "Distinctive method or signature in common"),

