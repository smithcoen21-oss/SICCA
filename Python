def create_app(dev_insecure_cookies: bool = False) -> Flask:
    Config.ensure_dirs()
    init_db()
    load_strength_factors()
    check_risk_reachability()

    app = Flask(__name__, template_folder=None,
                static_folder=str(Config.APP_ROOT / "static"))
    loader, _ = build_template_loader()
    app.jinja_loader = loader
    app.config.update(
        SECRET_KEY=load_or_create_secret_key(),
        MAX_CONTENT_LENGTH=Config.MAX_CONTENT_LENGTH,
        SESSION_COOKIE_HTTPONLY=True,
        SESSION_COOKIE_SAMESITE="Lax",
        SESSION_COOKIE_SECURE=(Config.COOKIE_SECURE
                               and not dev_insecure_cookies),
        PERMANENT_SESSION_LIFETIME=Config.SESSION_LIFETIME_SECONDS,
        WTF_CSRF_ENABLED=True,
    )
    if Config.BEHIND_PROXY:
        n = Config.BEHIND_PROXY
        app.wsgi_app = ProxyFix(app.wsgi_app, x_for=n, x_proto=n, x_host=n)
    CSRFProtect(app)
    login_manager.init_app(app)
    login_manager.login_view = "login"

    # ---- context processor for the score note (tuning item 7)
    @app.context_processor
    def inject_score_note_constants():
        return {
            "score_note_constants": {
                "base_prior": BayesianConfig.BASE_PRIOR,
                "high": BayesianConfig.HIGH,
                "medium": BayesianConfig.MEDIUM,
                "age_decay_lambda": BayesianConfig.AGE_DECAY_LAMBDA,
                "min_feature_lr": BayesianConfig.MIN_FEATURE_LR,
                "max_feature_lr": BayesianConfig.MAX_FEATURE_LR,
            }
        }

    # ---- helpers
    def can_access(row: sqlite3.Row) -> bool:
        if current_user.is_admin():
            return True
        me = current_user.username.lower()
        return (row["created_by"].lower() == me
                or (row["assigned_to"] or "").lower() == me)

    def scope() -> Tuple[str, Tuple[Any, ...]]:
        if current_user.is_admin():
            return "1=1", ()
        me = current_user.username.lower()
        return "(LOWER(created_by) = ? OR LOWER(assigned_to) = ?)", (me, me)

    def fetch_case(case_id: str) -> sqlite3.Row:
        ok, _ = validate_case_id(case_id)
        if not ok:
            abort(404)
        with db() as conn:
            row = conn.execute("SELECT * FROM cases WHERE case_id = ?",
                               (case_id,)).fetchone()
        if row is None or not can_access(row):
            abort(404)
        return row

    def render_create(status: int = 200, **extra):
        return render_template(
            "create_case.html",
            form=request.form if request.method == "POST" else {},
            types=CASE_TYPES, statuses=STATUSES,
            priorities=PRIORITIES, strengths=EVIDENCE_STRENGTHS, **extra), status

    def _compute_condition_profile(case: dict) -> dict:
        """Read matched temporal windows, weather conditions and MO
        conditions, compute LRs, combine via sicca_conditions."""
        if conditions is None:
            return {"combined_lr": 1.0,
                    "summary": "conditions module unavailable",
                    "temporal_lr": 1.0, "weather_lr": 1.0, "mo_lr": 1.0,
                    "n_temporal": 0, "n_weather": 0, "n_mo": 0}
        temporal_lrs, weather_lrs, mo_lrs = [], [], []
        # Temporal. Missing optional tables mean "no data", not an error.
        if temporal is not None:
            try:
                with db() as conn:
                    windows: List[dict] = []
                    rates: Dict[str, float] = {}
                    if _table_exists(conn, "time_window"):
                        windows = [dict(w) for w in conn.execute(
                            "SELECT * FROM time_window")]
                        if _table_exists(conn, "time_window_base_rate"):
                            rates = {r["window_id"]: float(r["base_rate"])
                                     for r in conn.execute(
                                "SELECT window_id, base_rate "
                                "FROM time_window_base_rate "
                                "WHERE note LIKE 'Empirical%'")}
                if windows:
                    prof = temporal.temporal_profile(
                        case, windows, empirical_base_rates=rates or None)
                    if prof.get("ok"):
                        for m in prof.get("matched", []):
                            br = m.get("base_rate")
                            if br and br > 0:
                                temporal_lrs.append(min(50.0, 1.0 / br))
            except Exception:
                LOG.exception("temporal profile failed for %s",
                              case.get("case_id"))
        # Weather
        if weather is not None:
            try:
                with db() as conn:
                    obs: List[dict] = []
                    conds: List[dict] = []
                    rates = {}
                    if (_table_exists(conn, "weather_condition")
                            and _table_exists(conn, "case_weather")):
                        obs = [dict(r) for r in conn.execute(
                            "SELECT * FROM case_weather WHERE case_id = ?",
                            (case["case_id"],))]
                        conds = [dict(r) for r in conn.execute(
                            "SELECT * FROM weather_condition")]
                        if _table_exists(conn, "weather_base_rate"):
                            rates = {r["condition_id"]: float(r["base_rate"])
                                     for r in conn.execute(
                                "SELECT condition_id, base_rate "
                                "FROM weather_base_rate "
                                "WHERE note LIKE 'Empirical%'")}
                if conds:
                    wprof = weather.weather_profile(
                        obs, conds, empirical_base_rates=rates or None)
                    if wprof.get("ok"):
                        for day in wprof.get("days", []):
                            for c in day.get("conditions", []):
                                if c.get("matched") and c.get("likelihood_ratio"):
                                    weather_lrs.append(
                                        float(c["likelihood_ratio"]))
            except Exception:
                LOG.exception("weather profile failed for %s",
                              case.get("case_id"))
        # MO: each attributed method contributes
        # 1 + (MO_LR_MAX - 1) * confidence (1.5 at full confidence).
        try:
            with db() as conn:
                rows = conn.execute(
                    "SELECT method_id, confidence FROM case_method "
                    "WHERE case_id = ?", (case["case_id"],)).fetchall()
            mo_lrs = [
                1.0 + (BayesianConfig.MO_LR_MAX - 1.0)
                * coerce_float(r["confidence"], 0.5, 0.0, 1.0)
                for r in rows]
        except sqlite3.OperationalError:
            pass
        return conditions.combine(
            temporal_lrs=temporal_lrs,
            weather_lrs=weather_lrs,
            mo_lrs=mo_lrs,
        )

    ml = MLModel(Config.MODEL_PATH, Config.MODEL_HASH_PATH,
                 key=app.config["SECRET_KEY"].encode("utf-8"))
    engine = HybridEngine(ml=ml, condition_fn=_compute_condition_profile)

    # ---- hooks
    @app.after_request
    def security_headers(resp):
        resp.headers.setdefault("X-Content-Type-Options", "nosniff")
        resp.headers.setdefault("X-Frame-Options", "DENY")
        resp.headers.setdefault("Referrer-Policy", "same-origin")
        if Config.CSP:
            resp.headers.setdefault("Content-Security-Policy", Config.CSP)
        if request.is_secure:
            resp.headers.setdefault("Strict-Transport-Security",
                                    "max-age=31536000; includeSubDomains")
        if current_user.is_authenticated:
            resp.headers["Cache-Control"] = "no-store"
        return resp

    @app.errorhandler(CSRFError)
    def csrf_error(_exc):
        return ("Security token missing or expired. Go back, reload the "
                "page and try again.", 400)

    @app.errorhandler(413)
    def too_large(_exc):
        mb = Config.MAX_CONTENT_LENGTH // (1024 * 1024)
        return f"Upload too large (limit {mb} MB).", 413

    # ---- auth
    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect(url_for("dashboard"))
        if request.method == "POST":
            username = clean_text(request.form.get("username"), 100)
            password = request.form.get("password", "")
            ip = request.remote_addr or "?"
            k_user, k_ip = f"u:{ip}|{username.lower()}", f"ip:{ip}"
            wait = max(THROTTLE.wait_seconds(k_user, 5),
                       THROTTLE.wait_seconds(k_ip, 30))
            if wait:
                flash(f"Too many failed attempts. Try again in "
                      f"{wait // 60 + 1} minute(s).", "error")
                return render_template("login.html"), 429
            with db() as conn:
                row = conn.execute(
                    "SELECT id, username, password, role FROM users "
                    "WHERE username = ?", (username,)).fetchone()
            valid = check_password_hash(
                row["password"] if row else _DUMMY_HASH, password)
            if row and valid:
                THROTTLE.clear(k_user)
                session.clear()
                login_user(User(row["id"], row["username"], row["role"]))
                session.permanent = True
                audit(row["username"], "login", row["username"])
                return redirect(url_for("dashboard"))
