def ensure_dirs() -> None:

    for d in (Config.BASE_DIR, Config.LOGS):

        d.mkdir(parents=True, exist_ok=True)





def secret_key() -> str:

    env = os.environ.get("SICCA_SECRET_KEY")

    if env:

        return env

    ensure_dirs()

    f = Config.BASE_DIR / "secret.key"

    if f.exists() and f.read_text().strip():

        return f.read_text().strip()

    k = secrets.token_hex(32)

    f.write_text(k)

    try:

        os.chmod(f, 0o600)

    except OSError:

        pass

    return k





def now_iso() -> str:

    return datetime.now(timezone.utc).isoformat(timespec="seconds")





def configure_logging() -> logging.Logger:

    ensure_dirs()

    lg = logging.getLogger("sicca")

    lg.setLevel(logging.INFO)

    if not lg.handlers:

        fmt = logging.Formatter("%(asctime)s %(levelname)s %(message)s")

        for h in (RotatingFileHandler(Config.LOGS / "sicca.log", maxBytes=5_000_000, backupCount=3),

                  logging.StreamHandler(sys.stdout)):

            h.setFormatter(fmt)

            lg.addHandler(h)

    return lg





