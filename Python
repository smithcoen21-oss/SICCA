@app.route("/upload_csv", methods=["POST"])
@login_required
def upload_csv():
    f = request.files.get("csv_file")
    if not f:
        flash("No file provided.", "error")
        return redirect(url_for("create_case"))

    raw = f.read()
    LOG.info("=== upload_csv DEBUG ===")
    LOG.info("filename=%r size=%d bytes", f.filename, len(raw))
    LOG.info("first 16 bytes=%r", raw[:16])
    LOG.info("first 300 chars=%r", raw[:300].decode("utf-8", errors="replace"))

    if not raw.strip():
        flash("The uploaded file is empty.", "error")
        return redirect(url_for("create_case"))

    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        try:
            text = raw.decode("latin-1")
            LOG.info("upload_csv: file decoded as latin-1 fallback")
        except Exception as e:
            flash(f"Could not decode file: {e}", "error")
            return redirect(url_for("create_case"))

    # Strip a possible leading 'sep=,' line (Excel/LibreOffice quirk)
    lines = text.splitlines()
    if lines and lines[0].lower().startswith("sep="):
        LOG.info("upload_csv: stripping 'sep=' line: %r", lines[0])
        text = "\n".join(lines[1:])

    try:
        df = pd.read_csv(io.StringIO(text), dtype=str, keep_default_na=False)
    except Exception as e:
        LOG.info("upload_csv: pandas read failed: %s", e)
        flash(f"Could not read CSV: {e}", "error")
        return redirect(url_for("create_case"))

    # Normalize header: strip whitespace and BOM leftovers
    df.columns = [str(c).lstrip("\ufeff").strip() for c in df.columns]
    LOG.info("upload_csv: columns=%r rows=%d", list(df.columns), len(df))

    if len(df) == 0:
        flash("The CSV has a header but no data rows.", "error")
        return redirect(url_for("create_case"))

    if not {"case_id", "case_name"} <= set(df.columns):
        flash(f"CSV needs columns case_id and case_name. Found: {list(df.columns)}", "error")
        return redirect(url_for("create_case"))

    ok, errs = 0, []
    with db() as c:
        for i, row in df.iterrows():
            rd = row.to_dict()
            # Normalize keys too
            rd = {str(k).lstrip("\ufeff").strip(): v for k, v in rd.items()}
            LOG.info("upload_csv: row %d raw=%r", i + 2, rd)
            try:
                d = validated_case(rd)
                LOG.info("upload_csv: row %d validated=%r", i + 2, d)
                inserted = insert_case(c, d)
                LOG.info("upload_csv: row %d inserted=%s", i + 2, inserted)
                if inserted:
                    ok += 1
                else:
                    errs.append(f"row {i + 2}: case_id '{d['case_id']}' already exists.")
            except ValueError as e:
                LOG.info("upload_csv: row %d rejected: %s", i + 2, e)
                errs.append(f"row {i + 2}: {e}")

    flash(f"Imported {ok} new case(s); skipped {len(df) - ok}.", "success" if ok else "error")
    for e in errs[:10]:
        flash(e, "error")
    return redirect(url_for("dashboard"))

