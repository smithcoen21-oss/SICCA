                params).fetchone()["n"]
            open_n = conn.execute(
                f"SELECT COUNT(*) AS n FROM cases WHERE {where} "
                "AND LOWER(status) = 'open'", params).fetchone()["n"]
            high_n = conn.execute(
                f"SELECT COUNT(*) AS n FROM cases WHERE {where} "
                "AND LOWER(priority) = 'high'", params).fetchone()["n"]
        return render_template(
            "dashboard.html",
