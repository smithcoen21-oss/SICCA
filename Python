REQUIRED_TEMPLATES = ("login.html", "dashboard.html", "create_case.html",
                      "view_case.html", "analysis.html", "train.html",
                      "calibration_trace.html", "calibration_sensitivity.html",
                      "case_temporal.html", "case_weather.html",
                      "case_mo.html", "case_links.html",
                      "corpus_dashboard.html")


def discover_template_dirs() -> List[Path]:
    found: List[Path] = []

    def add(p: Path) -> None:
        p = p.resolve()
        if p.is_dir() and p not in found:
            found.append(p)

    for raw in os.environ.get("SICCA_TEMPLATE_DIRS", "").split(os.pathsep):
        if raw.strip():
            add(Path(raw).expanduser())
    root = Config.APP_ROOT
    skip = set(Config.TEMPLATE_SKIP_DIRS) | {Config.BASE_DIR.name}
    for dirpath, dirnames, filenames in os.walk(root):
        try:
            depth = len(Path(dirpath).relative_to(root).parts)
        except ValueError:
            continue
        dirnames[:] = sorted(d for d in dirnames
                             if d not in skip and not d.startswith(".")
                             and depth < Config.TEMPLATE_SCAN_DEPTH)
        if any(f.lower().endswith(".html") for f in filenames):
            add(Path(dirpath))
    add(root)
    return found


def template_index(dirs: List[Path]) -> Dict[str, Path]:
    index: Dict[str, Path] = {}
    for d in dirs:
        for f in sorted(d.glob("*.html")):
            if f.name in index:
                LOG.warning("Duplicate template '%s': using %s, ignoring %s",
                            f.name, index[f.name], f)
            else:
                index[f.name] = f
    return index


def build_template_loader():
    dirs = discover_template_dirs()
    index = template_index(dirs)
    for name in REQUIRED_TEMPLATES:
        if name not in index:
            LOG.warning("Template '%s' not found in any folder; using the "
                        "built-in fallback.", name)
    loader = ChoiceLoader([FileSystemLoader([str(d) for d in dirs]),
                           DictLoader(FALLBACK_TEMPLATES)])
    return loader, index


