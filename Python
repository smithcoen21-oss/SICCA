def discover_template_dirs() -> List[Path]:
    found: List[Path] = []
    root = Config.APP_ROOT
    for dirpath, dirnames, filenames in os.walk(root):
        if any(f.lower().endswith(".html") for f in filenames):
            found.append(Path(dirpath))
    found.append(root)
    return found


def build_template_loader():
    dirs = discover_template_dirs()
    return ChoiceLoader([FileSystemLoader([str(d) for d in dirs]), DictLoader(FALLBACK_TEMPLATES)]), {}


