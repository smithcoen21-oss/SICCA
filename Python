CRIME_CATEGORY = {
    "homicide": "violent_crime", "assault": "violent_crime",
    "robbery": "violent_crime", "fraud": "financial_crime",
    "theft": "property_crime", "burglary": "property_crime",
    "arson": "property_crime", "vandalism": "property_crime",
}


class SeverityHeuristics:
    """Transparent severity score from crime category, evidence and suspects.

    It does NOT model borders or jurisdictions (the result key stays
    "cross_border" so existing templates keep working)."""

    CATEGORY_RISK = {
        "violent_crime": 0.8, "financial_crime": 0.4, "property_crime": 0.3,
    }
    DEFAULT_RISK = 0.5

    @staticmethod
    def risk(case: Mapping[str, Any]) -> Dict[str, Any]:
        category = CRIME_CATEGORY.get(str(case.get("type", "")).lower(),
                                      "other_crime")
        crime_risk = SeverityHeuristics.CATEGORY_RISK.get(
            category, SeverityHeuristics.DEFAULT_RISK)
        ev = coerce_int(case.get("evidence_count", 0), 0, 0, 10000)
        su = coerce_int(case.get("suspects_count", 0), 0, 0, 1000)
        score = (0.6 * crime_risk + 0.2 * min(1.0, ev / 10.0)
                 + 0.2 * min(1.0, su / 5.0))
        return {
            "risk_score": round(score, 3),
            "risk_level": risk_level(score),
            "crime_category": category,
            "method": "transparent_heuristic",
            "factors": ["crime_category", "evidence_count", "suspects_count"],
            "note": "Severity heuristic only; it does not model jurisdictions.",
        }


# Backwards-compatible alias.
CrossBorderHeuristics = SeverityHeuristics


