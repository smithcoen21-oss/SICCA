def load_or_create_secret_key() -> str:
    env = os.environ.get("SICCA_SECRET_KEY")
    if env:
        return env
    Config.BASE_DIR.mkdir(parents=True, exist_ok=True)
    keyfile = Config.BASE_DIR / "secret.key"

    def _read() -> str:
        key = keyfile.read_text().strip()
        if not key:
            raise RuntimeError(f"{keyfile} is empty; delete it and restart.")
        return key

    if keyfile.exists():
        return _read()
    tmp = keyfile.with_name(f"secret.key.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(secrets.token_hex(32))
    try:
        try:
            os.link(tmp, keyfile)
        except FileExistsError:
            pass
        except OSError:
            if not keyfile.exists():
                os.replace(tmp, keyfile)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
    return _read()


