        total = len(case_rows)
        case_ids = [c["case_id"] for c in case_rows]
        temporal_prevalence: Dict[str, int] = {}
        weather_prevalence: Dict[str, int] = {}
        mo_prevalence: Dict[str, int] = {}

        if case_rows and temporal is not None and windows:
            for case in case_rows:
                try:
                    prof = temporal.temporal_profile(case, windows)
                    if prof.get("ok"):
                        for m in prof.get("matched", []):
                            wid = m["window_id"]
                            temporal_prevalence[wid] = \
                                temporal_prevalence.get(wid, 0) + 1
                except Exception:
                    LOG.exception("temporal prevalence failed")

        if case_ids and weather is not None and conds:
            # A case counts once per condition, however many days of weather
            # observations it has; otherwise the percentages can top 100%.
            matched_by_case: Dict[str, set] = defaultdict(set)
            obs_rows: List[dict] = []
            with db() as conn:
                if _table_exists(conn, "case_weather"):
                    for chunk in _chunks(case_ids):
                        ph = ",".join("?" * len(chunk))
                        obs_rows.extend(dict(r) for r in conn.execute(
                            f"SELECT * FROM case_weather "
                            f"WHERE case_id IN ({ph})", chunk))
            for o in obs_rows:
                for c in conds:
                    try:
                        r = weather.evaluate_condition(o, c)
                        if r["matched"]:
                            matched_by_case[o["case_id"]].add(r["condition_id"])
                    except Exception:
                        LOG.exception("weather prevalence failed")
            for matched in matched_by_case.values():
                for cid in matched:
                    weather_prevalence[cid] = weather_prevalence.get(cid, 0) + 1

        if case_ids:
            with db() as conn:
                if _table_exists(conn, "case_method"):
                    for chunk in _chunks(case_ids):
                        ph = ",".join("?" * len(chunk))
                        for r in conn.execute(
                                f"SELECT method_id, COUNT(DISTINCT case_id) AS n "
                                f"FROM case_method WHERE case_id IN ({ph}) "
                                "GROUP BY method_id", chunk):
                            mo_prevalence[r["method_id"]] = (
                                mo_prevalence.get(r["method_id"], 0) + r["n"])

        def _pct(n):
            return round(100.0 * n / total, 1) if total else 0.0

        return render_template(
            "corpus_dashboard.html",
            total=total,
            by_type=[dict(r) for r in by_type],
            by_status=[dict(r) for r in by_status],
            by_priority=[dict(r) for r in by_priority],
            temporal_prevalence=[
                {"window_id": wid, "count": n, "pct": _pct(n)}
                for wid, n in sorted(temporal_prevalence.items(),
                                     key=lambda kv: -kv[1])],
            weather_prevalence=[
                {"condition_id": cid, "count": n, "pct": _pct(n)}
                for cid, n in sorted(weather_prevalence.items(),
                                     key=lambda kv: -kv[1])],
            mo_prevalence=[
                {"method_id": mid, "count": n, "pct": _pct(n)}
                for mid, n in sorted(mo_prevalence.items(),
                                     key=lambda kv: -kv[1])],
        )

    # ---- admin: train
    @app.route("/admin/train", methods=["GET", "POST"])
    @admin_required
    def train_model():
        if request.method == "POST":
            f = request.files.get("training_csv")
            if not f or not f.filename.lower().endswith(".csv"):
                flash("Upload a .csv file.", "error")
                return _train_page(400)
            try:
                df = pd.read_csv(f.stream, nrows=200_000)
            except Exception:
                flash("Could not read that CSV file.", "error")
                return _train_page(400)
            try:
                m = ml.train(df)
            except ValueError as exc:
                flash(str(exc), "error")
                return _train_page(400)
            except Exception:
                ref = secrets.token_hex(4)
                LOG.exception("Training failed (ref %s)", ref)
                flash(f"Training failed. Reference: {ref}", "error")
                return _train_page(500)
            audit(current_user.username, "train_model", "model",
                  f"rows={m['training_samples'] + m['test_samples']} "
                  f"auc={m['roc_auc']}")
            auc = "n/a" if m["roc_auc"] is None else f"{m['roc_auc']:.3f}"
            flash(f"Model trained. Test AUC {auc}, accuracy "
                  f"{m['accuracy']:.3f} on {m['test_samples']} held-out "
                  "rows.", "success")
            return redirect(url_for("train_model"))
        return _train_page()

    def _train_page(status: int = 200):
        return render_template("train.html", model_meta=ml.meta,
                               min_rows=Config.MIN_TRAIN_ROWS), status

    return app


