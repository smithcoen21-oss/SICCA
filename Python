CASE_ID_RE = re.compile(r"^[A-Za-z0-9_\-]{1,50}$")
CASE_TYPES = ("fraud", "homicide", "robbery", "arson", "burglary",
              "assault", "theft", "vandalism", "unknown")
STATUSES = ("open", "under investigation", "pending trial", "closed")
PRIORITIES = ("low", "medium", "high")


class FormError(ValueError):
    pass


def validate_case_id(case_id: str) -> Tuple[bool, str]:
    if not case_id or not CASE_ID_RE.match(case_id):
        return False, "Case ID must be 1-50 characters: letters, digits, - or _"
    return True, ""


def clean_text(value: Any, max_len: int = 1000) -> str:
    if value is None:
        return ""
    text = str(value).replace("\x00", "")
    text = "".join(ch for ch in text if ch in "\n\t" or ord(ch) >= 32)
    return text.strip()[:max_len]


def parse_int(raw: Any, label: str, lo: int, hi: int,
              default: Optional[int] = None) -> int:
    if raw is None or str(raw).strip() == "":
        if default is not None:
            return default
        raise FormError(f"{label} is required.")
    try:
        n = int(str(raw).strip())
    except ValueError:
        raise FormError(f"{label} must be a whole number.")
    if not lo <= n <= hi:
        raise FormError(f"{label} must be between {lo} and {hi}.")
    return n


def parse_float(raw: Any, label: str, lo: float, hi: float,
                default: Optional[float] = None) -> float:
    if raw is None or str(raw).strip() == "":
        if default is not None:
            return default
        raise FormError(f"{label} is required.")
    try:
        x = float(str(raw).strip())
    except ValueError:
        raise FormError(f"{label} must be a number.")
    if not isfinite(x) or not lo <= x <= hi:
        raise FormError(f"{label} must be between {lo} and {hi}.")
    return x


def parse_choice(raw: Any, label: str, choices: Tuple[str, ...],
                 default: str) -> str:
    value = clean_text(raw, 40).lower() or default
    if value not in choices:
        raise FormError(f"{label} must be one of: {', '.join(choices)}.")
    return value


def coerce_int(value: Any, default: int, lo: int, hi: int) -> int:
    try:
        n = int(float(value))
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


def coerce_float(value: Any, default: float, lo: float, hi: float) -> float:
    try:
        x = float(value)
    except (TypeError, ValueError):
        return default
    if not isfinite(x):
        return default
    return max(lo, min(hi, x))


def build_case_record(form: Mapping[str, Any], case_id: str,
                      username: str) -> Dict[str, Any]:
    name = clean_text(form.get("case_name"), 200)
    if not name:
        raise FormError("Case name is required.")
    now = now_iso()
    return {
        "case_id": case_id,
        "case_name": name,
        "location": clean_text(form.get("location"), 200),
        "year": parse_int(form.get("year"), "Year", 1900, 2100,
                          default=datetime.now().year),
        "type": parse_choice(form.get("type"), "Type", CASE_TYPES, "unknown"),
        "status": parse_choice(form.get("status"), "Status", STATUSES, "open"),
        "confidence": parse_float(form.get("confidence"), "Confidence",
                                  0.0, 1.0, default=0.5),
        "suspects_count": parse_int(form.get("suspects_count"),
                                    "Suspects", 0, 1000, default=0),
        "evidence_count": parse_int(form.get("evidence_count"),
                                    "Evidence items", 0, 10000, default=0),
        "description": clean_text(form.get("description"), 5000),
        "priority": parse_choice(form.get("priority"), "Priority",
                                 PRIORITIES, "medium"),
        "assigned_to": clean_text(form.get("assigned_to"), 100),
        "tags": clean_text(form.get("tags"), 500),
        "attached_file": None,
        "file_path": None,
        "created_by": username,
        "created": now,
        "modified": now,
    }


def sniff_matches(ext: str, head: bytes) -> bool:
    if ext == ".pdf":
        return head.startswith(b"%PDF-")
    if ext in (".jpg", ".jpeg"):
        return head.startswith(b"\xff\xd8\xff")
    if ext == ".png":
        return head.startswith(b"\x89PNG\r\n\x1a\n")
    if ext == ".docx":
        return head.startswith(b"PK\x03\x04")
    if ext == ".doc":
        return head.startswith(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1")
    if ext == ".txt":
        return b"\x00" not in head
    return False


def prepare_upload(file, case_id: str):
    if not file or not file.filename:
        return None
    ext = Path(file.filename).suffix.lower()
    if ext not in Config.ALLOWED_UPLOAD_EXTENSIONS:
        raise FormError(f"File type '{ext or 'unknown'}' is not allowed.")
    head = file.stream.read(16)
    file.stream.seek(0)
    if not sniff_matches(ext, head):
        raise FormError("File contents do not match its extension.")
    display = secure_filename(file.filename) or f"upload{ext}"
    stored = f"{secure_filename(case_id)}__{uuid.uuid4().hex[:8]}__{display}"
    return file, stored, display


# =============================================================================
# BAYESIAN MODEL (heuristic and UNCALIBRATED - decision support only)
# =============================================================================

class BayesianConfig:
    BASE_PRIOR = 0.30
    TYPE_LR = {
        "fraud": 1.2, "homicide": 2.0, "robbery": 1.6, "arson": 1.8,
        "burglary": 1.4, "assault": 1.7, "theft": 1.3,
        "vandalism": 1.1, "unknown": 1.0,
    }
    AGE_DECAY_LAMBDA = 0.05
    MAX_FEATURE_LR = 6.0
    MIN_FEATURE_LR = 0.25
    HIGH = 0.70
    MEDIUM = 0.40


def risk_level(score: float) -> str:
    return ("high" if score > BayesianConfig.HIGH
            else "medium" if score > BayesianConfig.MEDIUM else "low")


def _odds(p: float) -> float:
    p = min(max(p, 1e-6), 1 - 1e-6)
    return p / (1 - p)


def _prob(o: float) -> float:
    return o / (1 + o)


def _evidence_lr(evidence_count: int, suspects_count: int,
                 status: str, priority: str) -> float:
    ev = 1.0 + 0.35 * float(np.log1p(max(0, evidence_count)))
    su = 1.0 + 0.10 * max(0, suspects_count - 1)
    st = {"open": 1.05, "under investigation": 1.15,
          "pending trial": 1.25, "closed": 0.90}.get(status.lower(), 1.0)
    pr = {"high": 1.10, "medium": 1.00, "low": 0.90}.get(priority.lower(), 1.0)
    lr = float(ev * su * st * pr)
    return max(BayesianConfig.MIN_FEATURE_LR,
               min(BayesianConfig.MAX_FEATURE_LR, lr))


def bayesian_score(case: Mapping[str, Any], current_year: int) -> Dict[str, Any]:
    ctype = str(case.get("type", "unknown")).lower()
    type_lr = BayesianConfig.TYPE_LR.get(ctype, 1.0)
    ev_lr = _evidence_lr(
        coerce_int(case.get("evidence_count", 0), 0, 0, 10000),
        coerce_int(case.get("suspects_count", 0), 0, 0, 1000),
        str(case.get("status", "open")),
        str(case.get("priority", "medium")),
    )
    posterior = _prob(_odds(BayesianConfig.BASE_PRIOR) * type_lr * ev_lr)
    base_conf = coerce_float(case.get("confidence", 0.5), 0.5, 0.0, 1.0)
    year = coerce_int(case.get("year", current_year), current_year, 1900, 2100)
    age = max(0, current_year - year)
    decayed_conf = max(0.0, min(1.0, base_conf * exp(
        -BayesianConfig.AGE_DECAY_LAMBDA * age)))
    adjusted = posterior * (0.5 + 0.5 * decayed_conf)
    return {
        "posterior": float(posterior),
        "adjusted_posterior": float(adjusted),
        "confidence": float(decayed_conf),
        "prior_used": BayesianConfig.BASE_PRIOR,
        "type_likelihood_ratio": float(type_lr),
        "evidence_likelihood_ratio": float(ev_lr),
        "risk_level": risk_level(adjusted),
        "calibrated": False,
    }


def max_reachable_score(ctype: str) -> float:
    lr = (BayesianConfig.TYPE_LR.get(ctype, 1.0)
          * BayesianConfig.MAX_FEATURE_LR)
    return _prob(_odds(BayesianConfig.BASE_PRIOR) * lr)


def check_risk_reachability() -> None:
    for ctype in CASE_TYPES:
        top = max_reachable_score(ctype)
        if top <= BayesianConfig.HIGH:
            LOG.warning("Risk config: '%s' can never exceed %.2f, so it can "
                        "never be rated 'high'.", ctype, top)


